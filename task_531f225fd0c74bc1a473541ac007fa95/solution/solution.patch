+                    "Wait state activation already claimed by timeout or compensation",
+                    FrameworkErrorCode.OperationDenied);
+        }
+
+        if (!ExecutionStatus.WA.equals(waitStateInst.getStatus())) {
+            throw new EngineExecutionException(
+                    "Wait state is not in WA status: " + waitStateInst.getStatus(), FrameworkErrorCode.OperationDenied);
+        }
+
+        if (!event.equals(waitState.getEvent())) {
+            throw new EngineExecutionException(
+                    "Event[" + event + "] does not match expected event[" + waitState.getEvent() + "]",
+                    FrameworkErrorCode.OperationDenied);
