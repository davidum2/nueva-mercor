+package org.apache.seata.saga.statelang.domain;
+
+import java.time.Duration;
+import java.util.Map;
+
+/**
+ * Public domain representation of a parsed Wait state.
+ */
+public interface WaitState extends State {
+
+    /**
+     * Get the required external event name matched by signal delivery.
+     *
+     * @return the event name
+     */
+    String getEvent();
+
+    /**
+     * Set the event name.
+     *
+     * @param event the event name
+     */
+    void setEvent(String event);
+
+    /**
+     * Get the optional output mapping applied to the winning signal payload.
+     *
+     * @return the output mapping
+     */
+    Map<String, Object> getOutput();
+
+    /**
+     * Set the output mapping.
+     *
+     * @param output the output mapping
+     */
+    void setOutput(Map<String, Object> output);
+
+    /**
+     * Get the optional strictly positive ISO-8601 duration, or null for an indefinite wait.
+     *
+     * @return the timeout duration
+     */
+    Duration getTimeout();
+
+    /**
+     * Set the timeout duration.
+     *
+     * @param timeout the timeout duration
+     */
+    void setTimeout(Duration timeout);
+
+    /**
+     * Get the timeout successor, present exactly when getTimeout() is present.
+     *
+     * @return the timeout successor state name
+     */
+    String getTimeoutNext();
+
+    /**
+     * Set the timeout successor state name.
+     *
+     * @param timeoutNext the timeout successor state name
+     */
+    void setTimeoutNext(String timeoutNext);
+}
