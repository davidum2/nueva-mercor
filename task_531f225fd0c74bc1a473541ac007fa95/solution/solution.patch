+package org.apache.seata.saga.statelang.parser.impl;
+
+import org.apache.seata.common.util.StringUtils;
+import org.apache.seata.saga.statelang.domain.WaitState;
+import org.apache.seata.saga.statelang.domain.impl.WaitStateImpl;
+import org.apache.seata.saga.statelang.parser.StateParser;
+
+import java.time.Duration;
+import java.util.Map;
+
+/**
+ * Parser for {@link WaitState}.
+ */
+public class WaitStateParser extends BaseStateParser implements StateParser<WaitState> {
+
+    @Override
+    public WaitState parse(Object node) {
+        WaitStateImpl waitState = new WaitStateImpl();
+        parseBaseAttributes(waitState, node);
+
+        Map<String, Object> nodeMap = (Map<String, Object>) node;
+
+        String event = (String) nodeMap.get("Event");
+        if (StringUtils.isBlank(event)) {
+            throw new IllegalArgumentException("Wait state requires a non-blank Event property");
+        }
+        waitState.setEvent(event);
+
+        Object outputObj = nodeMap.get("Output");
+        if (outputObj instanceof Map) {
+            waitState.setOutput((Map<String, Object>) outputObj);
+        }
+
+        String timeoutStr = (String) nodeMap.get("Timeout");
+        String timeoutNext = (String) nodeMap.get("TimeoutNext");
+
+        boolean hasTimeout = StringUtils.isNotBlank(timeoutStr);
+        boolean hasTimeoutNext = StringUtils.isNotBlank(timeoutNext);
+
+        if (hasTimeout != hasTimeoutNext) {
+            throw new IllegalArgumentException(
+                    "Wait state Timeout and TimeoutNext must either both be present or both absent");
+        }
+
+        if (hasTimeout) {
+            Duration duration;
+            try {
+                duration = Duration.parse(timeoutStr);
+            } catch (Exception e) {
+                throw new IllegalArgumentException("Invalid ISO-8601 Timeout duration: " + timeoutStr, e);
+            }
+
+            if (duration.isZero() || duration.isNegative()) {
+                throw new IllegalArgumentException(
+                        "Wait state Timeout must be a strictly positive duration: " + timeoutStr);
+            }
+
+            waitState.setTimeout(duration);
+            waitState.setTimeoutNext(timeoutNext);
+        }
+
+        return waitState;
+    }
+}
