+
+    private void cancelDescendantWaits(StateMachineInstance machine) {
+        if (machine == null || stateMachineConfig.getStateLogStore() == null) {
+            return;
+        }
+        if (machine.getStateList() != null) {
+            for (StateInstance stateInst : machine.getStateList()) {
+                if (StateType.WAIT.equals(stateInst.getType()) && ExecutionStatus.WA.equals(stateInst.getStatus())) {
+                    stateMachineConfig
+                            .getStateLogStore()
+                            .claimWaitStateInstance(stateInst.getId(), machine.getId(), ExecutionStatus.FA, null);
+                    stateInst.setStatus(ExecutionStatus.FA);
+                }
+                if (StateType.SUB_STATE_MACHINE.equals(stateInst.getType())) {
+                    List<StateMachineInstance> children = stateMachineConfig
+                            .getStateLogStore()
+                            .queryStateMachineInstanceByParentId(EngineUtils.generateParentId(stateInst));
+                    if (CollectionUtils.isNotEmpty(children)) {
+                        for (StateMachineInstance child : children) {
+                            StateMachineInstance reloadedChild = reloadStateMachineInstance(child.getId());
+                            cancelDescendantWaits(reloadedChild);
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    private void unwindParentIfFinished(StateMachineInstance childMachine) {
+        StateMachineInstance reloadedChild = reloadStateMachineInstance(childMachine.getId());
+        if (reloadedChild == null
+                || (!ExecutionStatus.SU.equals(reloadedChild.getStatus())
+                        && !ExecutionStatus.FA.equals(reloadedChild.getStatus()))) {
+            return;
+        }
+        childMachine = reloadedChild;
+
+        String parentId = childMachine.getParentId();
+        if (StringUtils.isBlank(parentId) || !parentId.contains(DomainConstants.SEPERATOR_PARENT_ID)) {
+            return;
+        }
+        String[] parts = parentId.split(DomainConstants.SEPERATOR_PARENT_ID);
+        String parentMachineId = parts[0];
+        String parentStateInstId = parts.length > 1 ? parts[1] : null;
+
+        StateMachineInstance parentMachine = reloadStateMachineInstance(parentMachineId);
+        if (parentMachine == null || !ExecutionStatus.WA.equals(parentMachine.getStatus())) {
+            return;
+        }
+
+        StateInstance parentStateInst = parentStateInstId != null && parentMachine.getStateMap() != null
+                ? parentMachine.getStateMap().get(parentStateInstId)
+                : null;
+        if (parentStateInst == null && parentMachine.getStateList() != null) {
+            for (StateInstance si : parentMachine.getStateList()) {
+                if (parentStateInstId != null && parentStateInstId.equals(si.getId())) {
+                    parentStateInst = si;
+                    break;
+                }
+            }
+        }
+        if (parentStateInst == null) {
+            return;
+        }
+
+        ExecutionStatus childStatus = childMachine.getStatus();
+        parentStateInst.setStatus(childStatus);
+
+        Map<String, Object> outputParams =
+                childMachine.getEndParams() != null ? childMachine.getEndParams() : new HashMap<>();
+        outputParams.put(DomainConstants.VAR_NAME_SUB_STATEMACHINE_EXEC_STATUE, childStatus.toString());
+        parentStateInst.setOutputParams(outputParams);
+
+        State parentStateDef =
+                parentMachine.getStateMachine().getState(EngineUtils.getOriginStateName(parentStateInst));
+        if (parentStateDef == null) {
+            return;
+        }
+
+        ProcessContextBuilder contextBuilder = ProcessContextBuilder.create()
+                .withProcessType(ProcessType.STATE_LANG)
+                .withOperationName(DomainConstants.OPERATION_NAME_FORWARD)
+                .withStateMachineInstance(parentMachine)
+                .withStateInstance(parentStateInst)
+                .withStateMachineConfig(getStateMachineConfig())
+                .withStateMachineEngine(this)
+                .withIsAsyncExecution(false);
+
+        ProcessContext parentContext = contextBuilder.build();
+
+        if (stateMachineConfig.getStateLogStore() != null
+                && parentMachine.getStateMachine().isPersist()) {
+            stateMachineConfig.getStateLogStore().recordStateFinished(parentStateInst, parentContext);
+        }
+        Map<String, Object> contextVariables = getStateMachineContextVariables(parentMachine);
+
+        if (parentStateDef instanceof org.apache.seata.saga.statelang.domain.impl.SubStateMachineImpl) {
+            org.apache.seata.saga.statelang.domain.impl.SubStateMachineImpl subState =
+                    (org.apache.seata.saga.statelang.domain.impl.SubStateMachineImpl) parentStateDef;
+            if (CollectionUtils.isNotEmpty(subState.getOutput())) {
+                try {
+                    Map<String, Object> outMap = ParameterUtils.createOutputParams(
+                            stateMachineConfig.getExpressionResolver(), subState.getOutput(), outputParams);
+                    if (CollectionUtils.isNotEmpty(outMap)) {
+                        contextVariables.putAll(outMap);
+                    }
+                } catch (Exception ignored) {
+                }
+            }
+        }
+
+        putBusinessKeyToContextVariables(parentMachine, contextVariables);
+        ConcurrentHashMap<String, Object> concurrentContextVariables = new ConcurrentHashMap<>(contextVariables.size());
+        nullSafeCopy(contextVariables, concurrentContextVariables);
+        parentContext.setVariable(DomainConstants.VAR_NAME_STATEMACHINE_CONTEXT, concurrentContextVariables);
+        parentMachine.setContext(concurrentContextVariables);
+
+        String next = parentStateDef.getNext();
+        if (StringUtils.isEmpty(next)) {
+            EngineUtils.endStateMachine(parentContext);
+            if (StringUtils.hasText(parentMachine.getParentId())) {
+                unwindParentIfFinished(parentMachine);
+            }
+            return;
+        }
+
+        StateInstruction parentInstruction = new StateInstruction();
+        parentInstruction.setTenantId(parentMachine.getTenantId());
+        parentInstruction.setStateMachineName(parentMachine.getStateMachine().getName());
+        parentInstruction.setStateName(next);
+        parentContext.setInstruction(parentInstruction);
+
+        parentMachine.setStatus(ExecutionStatus.RU);
+        parentMachine.setRunning(true);
+
+        if (parentMachine.getStateMachine().isPersist() && stateMachineConfig.getStateLogStore() != null) {
+            stateMachineConfig.getStateLogStore().recordStateMachineRestarted(parentMachine, parentContext);
+        }
+
+        try {
+            stateMachineConfig.getProcessCtrlEventPublisher().publish(parentContext);
+            if (StringUtils.hasText(parentMachine.getParentId())) {
+                unwindParentIfFinished(parentMachine);
+            }
+        } catch (EngineExecutionException e) {
+            LOGGER.error("Unwind parent failed", e);
+        }
+    }
 }
