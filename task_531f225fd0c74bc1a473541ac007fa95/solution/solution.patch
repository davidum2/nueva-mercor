+    @Override
+    public int fireDueTimeouts(java.time.Instant now) throws EngineExecutionException {
+        if (now == null) {
+            throw new EngineExecutionException("now cannot be null", FrameworkErrorCode.InvalidParameter);
+        }
+
+        if (stateMachineConfig.getStateLogStore() == null) {
+            return 0;
+        }
+
+        List<StateInstance> waitingInstances =
+                stateMachineConfig.getStateLogStore().queryWaitingStateInstances(null);
+        if (CollectionUtils.isEmpty(waitingInstances)) {
+            return 0;
+        }
+
+        int claimedCount = 0;
+        for (StateInstance waitInst : waitingInstances) {
+            StateMachineInstance machineInst = reloadStateMachineInstance(waitInst.getMachineInstanceId());
+            if (machineInst == null || !ExecutionStatus.WA.equals(machineInst.getStatus())) {
+                continue;
+            }
+
+            State stateDef = machineInst.getStateMachine().getState(EngineUtils.getOriginStateName(waitInst));
+            if (!(stateDef instanceof org.apache.seata.saga.statelang.domain.WaitState)) {
+                continue;
+            }
+
+            org.apache.seata.saga.statelang.domain.WaitState waitState =
+                    (org.apache.seata.saga.statelang.domain.WaitState) stateDef;
+            if (waitState.getTimeout() == null) {
+                continue;
+            }
+
+            java.time.Instant deadline = waitInst.getGmtStarted().toInstant().plus(waitState.getTimeout());
+            if (deadline.compareTo(now) <= 0) {
+                boolean claimed = stateMachineConfig
+                        .getStateLogStore()
+                        .claimWaitStateInstance(waitInst.getId(), machineInst.getId(), ExecutionStatus.SK, null);
+                if (claimed) {
+                    claimedCount++;
+                    waitInst.setStatus(ExecutionStatus.SK);
+
+                    ProcessContextBuilder contextBuilder = ProcessContextBuilder.create()
+                            .withProcessType(ProcessType.STATE_LANG)
+                            .withOperationName(DomainConstants.OPERATION_NAME_FORWARD)
+                            .withStateMachineInstance(machineInst)
+                            .withStateInstance(waitInst)
+                            .withStateMachineConfig(getStateMachineConfig())
+                            .withStateMachineEngine(this)
+                            .withIsAsyncExecution(false);
+
+                    ProcessContext context = contextBuilder.build();
+
+                    Map<String, Object> contextVariables = getStateMachineContextVariables(machineInst);
+                    putBusinessKeyToContextVariables(machineInst, contextVariables);
+                    ConcurrentHashMap<String, Object> concurrentContextVariables =
+                            new ConcurrentHashMap<>(contextVariables.size());
+                    nullSafeCopy(contextVariables, concurrentContextVariables);
+                    context.setVariable(DomainConstants.VAR_NAME_STATEMACHINE_CONTEXT, concurrentContextVariables);
+                    machineInst.setContext(concurrentContextVariables);
+
+                    String timeoutNext = waitState.getTimeoutNext();
+                    if (StringUtils.isEmpty(timeoutNext)) {
+                        EngineUtils.endStateMachine(context);
+                        if (StringUtils.hasText(machineInst.getParentId())) {
+                            unwindParentIfFinished(machineInst);
+                        }
+                        continue;
+                    }
+
+                    StateInstruction inst = new StateInstruction();
+                    inst.setTenantId(machineInst.getTenantId());
+                    inst.setStateMachineName(machineInst.getStateMachine().getName());
+                    inst.setStateName(timeoutNext);
+                    context.setInstruction(inst);
+
+                    machineInst.setStatus(ExecutionStatus.RU);
+                    machineInst.setRunning(true);
+
+                    if (machineInst.getStateMachine().isPersist() && stateMachineConfig.getStateLogStore() != null) {
+                        stateMachineConfig.getStateLogStore().recordStateMachineRestarted(machineInst, context);
+                    }
+
+                    try {
+                        stateMachineConfig.getProcessCtrlEventPublisher().publish(context);
+                        if (StringUtils.hasText(machineInst.getParentId())) {
+                            unwindParentIfFinished(machineInst);
+                        }
+                    } catch (EngineExecutionException e) {
