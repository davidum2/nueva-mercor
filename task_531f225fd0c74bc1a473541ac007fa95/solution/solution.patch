+            waitStateInst = stateMachineInstance.getStateMap().get(waitStateInstanceId);
+        }
+        if (waitStateInst == null && stateMachineInstance.getStateList() != null) {
+            for (StateInstance si : stateMachineInstance.getStateList()) {
