+static bool gslc_RectsOverlap(gslc_tsRect r1, gslc_tsRect r2) {
+  int32_t x0 = (r1.x > r2.x) ? r1.x : r2.x;
+  int32_t y0 = (r1.y > r2.y) ? r1.y : r2.y;
+  int32_t r1_x1 = (int32_t)r1.x + r1.w;
+  int32_t r2_x1 = (int32_t)r2.x + r2.w;
+  int32_t r1_y1 = (int32_t)r1.y + r1.h;
+  int32_t r2_y1 = (int32_t)r2.y + r2.h;
+  int32_t x1 = (r1_x1 < r2_x1) ? r1_x1 : r2_x1;
+  int32_t y1 = (r1_y1 < r2_y1) ? r1_y1 : r2_y1;
+  return (x0 < x1) && (y0 < y1);
+}
+
+static gslc_tsRect gslc_GetUnionRect(gslc_tsRect r1, gslc_tsRect r2) {
+  int32_t x0 = (r1.x < r2.x) ? r1.x : r2.x;
+  int32_t y0 = (r1.y < r2.y) ? r1.y : r2.y;
+  int32_t r1_x1 = (int32_t)r1.x + r1.w;
+  int32_t r2_x1 = (int32_t)r2.x + r2.w;
+  int32_t r1_y1 = (int32_t)r1.y + r1.h;
+  int32_t r2_y1 = (int32_t)r2.y + r2.h;
+  int32_t x1 = (r1_x1 > r2_x1) ? r1_x1 : r2_x1;
+  int32_t y1 = (r1_y1 > r2_y1) ? r1_y1 : r2_y1;
+  return (gslc_tsRect){ (int16_t)x0, (int16_t)y0, (uint16_t)(x1 - x0), (uint16_t)(y1 - y0) };
+}
+
+static bool gslc_ClampRectToDisplay(gslc_tsGui* pGui, gslc_tsRect* pRect) {
+  int32_t rx = pRect->x;
+  int32_t ry = pRect->y;
+  int32_t rw = pRect->w;
+  int32_t rh = pRect->h;
+
+  if (rx < 0) {
+    rw += rx;
+    rx = 0;
+  }
+  if (ry < 0) {
+    rh += ry;
+    ry = 0;
+  }
+
+  int32_t dw = pGui->nDispW;
+  int32_t dh = pGui->nDispH;
+
+  if (rx >= dw || ry >= dh || rw <= 0 || rh <= 0) {
+    pRect->w = 0;
+    pRect->h = 0;
+    return false;
+  }
+
+  if (rx + rw > dw) {
+    rw = dw - rx;
+  }
+  if (ry + rh > dh) {
+    rh = dh - ry;
+  }
+
+  if (rw <= 0 || rh <= 0) {
+    pRect->w = 0;
+    pRect->h = 0;
+    return false;
+  }
+
+  pRect->x = (int16_t)rx;
+  pRect->y = (int16_t)ry;
+  pRect->w = (uint16_t)rw;
+  pRect->h = (uint16_t)rh;
+  return true;
+}
+
+// Canonical region ordering: ascending by y, then x, then h, then w
+static bool gslc_RectLess(gslc_tsRect r1, gslc_tsRect r2) {
+  if (r1.y != r2.y) { return r1.y < r2.y; }
+  if (r1.x != r2.x) { return r1.x < r2.x; }
+  if (r1.h != r2.h) { return r1.h < r2.h; }
+  return r1.w < r2.w;
+}
+
+static void gslc_SortRects(gslc_tsRect* asRect, uint8_t nCnt) {
+  for (uint8_t i = 1; i < nCnt; i++) {
+    gslc_tsRect key = asRect[i];
+    int16_t j = i - 1;
+    while (j >= 0 && gslc_RectLess(key, asRect[j])) {
+      asRect[j + 1] = asRect[j];
+      j--;
+    }
+    asRect[j + 1] = key;
+  }
+}
