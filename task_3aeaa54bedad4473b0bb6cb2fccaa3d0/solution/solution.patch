+void gslc_InvalidateRgnAdd(gslc_tsGui* pGui, gslc_tsRect rAddRect)
+{
+  if (pGui == NULL) {
+    return;
+  }
+
+  gslc_tsRect rClamped = rAddRect;
+  if (!gslc_ClampRectToDisplay(pGui, &rClamped)) {
+    return;
+  }
+
   pGui->bInvalidateEn = true;
+
+  // 1. Create a local temporary array to hold the active regions plus the new one
+  gslc_tsRect temp[GSLC_INVALIDATE_RGN_MAX + 1];
+  uint8_t temp_cnt = 0;
+
+  // Copy existing regions to temp
+  for (uint8_t i = 0; i < pGui->nInvalidateRgnCnt; i++) {
+    temp[temp_cnt++] = pGui->asInvalidateRect[i];
+  }
+
+  // 2. Coalesce the new region transitively with the existing regions in temp
+  gslc_tsRect r = rClamped;
+  bool coalesced = true;
+  while (coalesced) {
+    coalesced = false;
+    for (uint8_t i = 0; i < temp_cnt; i++) {
+      if (gslc_RectsOverlap(r, temp[i])) {
+        r = gslc_GetUnionRect(r, temp[i]);
+        // Remove temp[i]
+        for (uint8_t j = i; j < temp_cnt - 1; j++) {
+          temp[j] = temp[j + 1];
+        }
+        temp_cnt--;
+        coalesced = true;
+        break;
+      }
+    }
+  }
+
+  // Append the coalesced region to temp
+  temp[temp_cnt++] = r;
+
+  // 3. If count exceeds max, repeatedly merge the optimal pair
+  while (temp_cnt > GSLC_INVALIDATE_RGN_MAX) {
+    int32_t min_added_area = -1;
+    uint8_t best_i = 0, best_j = 0;
+
+    // Keep the candidates in canonical order so that the first pair found
+    // with the least wasted area is also the canonically smallest one
+    gslc_SortRects(temp, temp_cnt);
+
+    for (uint8_t i = 0; i < temp_cnt; i++) {
+      for (uint8_t j = i + 1; j < temp_cnt; j++) {
+        gslc_tsRect a = temp[i];
+        gslc_tsRect b = temp[j];
+        gslc_tsRect u = gslc_GetUnionRect(a, b);
+
+        int32_t area_a = (int32_t)a.w * a.h;
+        int32_t area_b = (int32_t)b.w * b.h;
+        int32_t area_u = (int32_t)u.w * u.h;
+        int32_t added_area = area_u - area_a - area_b;
+
+        if (min_added_area == -1 || added_area < min_added_area) {
+          min_added_area = added_area;
+          best_i = i;
+          best_j = j;
+        }
+      }
+    }
+
+    // Merge the best pair
+    gslc_tsRect merged = gslc_GetUnionRect(temp[best_i], temp[best_j]);
+
+    // Remove best_j (which is > best_i)
+    for (uint8_t k = best_j; k < temp_cnt - 1; k++) {
+      temp[k] = temp[k + 1];
+    }
+    temp_cnt--;
+
+    // Remove best_i
+    for (uint8_t k = best_i; k < temp_cnt - 1; k++) {
+      temp[k] = temp[k + 1];
+    }
+    temp_cnt--;
+
+    // Now transitively coalesce the merged region with the remaining ones in temp
+    gslc_tsRect r_m = merged;
+    coalesced = true;
+    while (coalesced) {
+      coalesced = false;
+      for (uint8_t i = 0; i < temp_cnt; i++) {
+        if (gslc_RectsOverlap(r_m, temp[i])) {
+          r_m = gslc_GetUnionRect(r_m, temp[i]);
+          for (uint8_t j = i; j < temp_cnt - 1; j++) {
+            temp[j] = temp[j + 1];
+          }
+          temp_cnt--;
+          coalesced = true;
+          break;
+        }
+      }
+    }
+
+    // Append the coalesced merged region to temp
+    temp[temp_cnt++] = r_m;
+  }
+
+  // 4. Copy the result back to GUIslice's state
+  pGui->nInvalidateRgnCnt = temp_cnt;
+  for (uint8_t i = 0; i < temp_cnt; i++) {
+    pGui->asInvalidateRect[i] = temp[i];
+  }
 }
 
