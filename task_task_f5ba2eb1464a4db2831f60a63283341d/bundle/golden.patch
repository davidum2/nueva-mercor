diff --git a/src/client/components/terminal/event-emitter.js b/src/client/components/terminal/event-emitter.js
new file mode 100644
index 00000000..caeea943
--- /dev/null
+++ b/src/client/components/terminal/event-emitter.js
@@ -0,0 +1,27 @@
+export default class EventEmitter {
+  constructor () {
+    this._events = {}
+  }
+
+  on (event, listener) {
+    if (!this._events[event]) {
+      this._events[event] = []
+    }
+    this._events[event].push(listener)
+    return this
+  }
+
+  off (event, listener) {
+    if (!this._events[event]) return this
+    this._events[event] = this._events[event].filter(l => l !== listener)
+    return this
+  }
+
+  emit (event, ...args) {
+    if (!this._events[event]) return false
+    this._events[event].forEach(listener => {
+      listener(...args)
+    })
+    return true
+  }
+}
