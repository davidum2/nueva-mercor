+namespace Google\Cloud\Samples\Dlp;
+
+# [START dlp_deidentify_cloud_storage]
+use Google\Cloud\Dlp\V2\Action;
+use Google\Cloud\Dlp\V2\Action\Deidentify;
+use Google\Cloud\Dlp\V2\BigQueryTable;
+use Google\Cloud\Dlp\V2\CloudStorageOptions;
+use Google\Cloud\Dlp\V2\CloudStorageOptions\FileSet;
+use Google\Cloud\Dlp\V2\DlpJob\JobState;
+use Google\Cloud\Dlp\V2\DlpServiceClient;
+use Google\Cloud\Dlp\V2\FileType;
+use Google\Cloud\Dlp\V2\InspectJobConfig;
+use Google\Cloud\Dlp\V2\StorageConfig;
+use Google\Cloud\Dlp\V2\TransformationConfig;
+use Google\Cloud\Dlp\V2\TransformationDetailsStorageConfig;
+
+/**
+ * De-identify sensitive data in Cloud Storage files.
+ *
+ * @param string $callingProjectId              The project ID to run the API call under
+ * @param string $inputGcsUri                   The Cloud Storage location to inspect and de-identify (e.g. "gs://bucket_name/input_file.txt" or "gs://bucket_name/path/*")
+ * @param string $outputGcsUri                  The Cloud Storage location to store de-identified files (e.g. "gs://bucket_name/output/")
+ * @param string $deidentifyTemplate            The de-identification template for unstructured files
+ * @param string $structuredDeidentifyTemplate  The de-identification template for structured files
+ * @param string $imageRedactTemplate           The de-identification template for images
+ * @param string $datasetId                     The BigQuery dataset ID for transformation details
+ * @param string $tableId                       The BigQuery table ID for transformation details
+ */
+function deidentify_cloud_storage(
+    string $callingProjectId,
+    string $inputGcsUri,
+    string $outputGcsUri,
+    string $deidentifyTemplate,
+    string $structuredDeidentifyTemplate,
+    string $imageRedactTemplate,
+    string $datasetId,
+    string $tableId
+): void {
+    // Instantiate a client.
+    $dlp = new DlpServiceClient();
+
+    // Specify the Cloud Storage location to inspect and de-identify.
+    $cloudStorageOptions = (new CloudStorageOptions())
+        ->setFileSet((new FileSet())
+            ->setUrl($inputGcsUri));
+
+    $storageConfig = (new StorageConfig())
+        ->setCloudStorageOptions($cloudStorageOptions);
+
+    // Configure de-identification templates for unstructured, structured, and image files.
+    $transformationConfig = (new TransformationConfig())
+        ->setDeidentifyTemplate($deidentifyTemplate)
+        ->setStructuredDeidentifyTemplate($structuredDeidentifyTemplate)
+        ->setImageRedactTemplate($imageRedactTemplate);
+
+    // Configure BigQuery table for storing transformation details.
+    $bigQueryTable = (new BigQueryTable())
+        ->setProjectId($callingProjectId)
+        ->setDatasetId($datasetId)
+        ->setTableId($tableId);
+
+    $transformationDetailsStorageConfig = (new TransformationDetailsStorageConfig())
+        ->setTable($bigQueryTable);
+
+    // Configure the de-identification action.
+    $deidentifyAction = (new Deidentify())
+        ->setTransformationConfig($transformationConfig)
+        ->setTransformationDetailsStorageConfig($transformationDetailsStorageConfig)
+        ->setCloudStorageOutput($outputGcsUri)
+        ->setFileTypesToTransform([
+            FileType::IMAGE,
+            FileType::CSV,
+            FileType::TEXT_FILE,
+        ]);
+
+    $action = (new Action())
+        ->setDeidentify($deidentifyAction);
+
+    // Configure the inspection job.
+    $inspectJobConfig = (new InspectJobConfig())
+        ->setStorageConfig($storageConfig)
+        ->setActions([$action]);
+
+    // Submit the de-identification job.
+    $parent = "projects/$callingProjectId/locations/global";
+    $job = $dlp->createDlpJob($parent, [
+        'inspectJob' => $inspectJobConfig,
+    ]);
+
+    // Wait for the job to complete.
+    $job = $dlp->getDlpJob($job->getName());
+    while ($job->getState() == JobState::RUNNING || $job->getState() == JobState::PENDING) {
+        printf('Waiting for job to complete' . PHP_EOL);
+        sleep(5);
+        $job = $dlp->getDlpJob($job->getName());
+    }
+
+    // Print results.
+    printf('Job %s status: %s' . PHP_EOL, $job->getName(), JobState::name($job->getState()));
+    switch ($job->getState()) {
+        case JobState::DONE:
+            $infoTypeStats = $job->getInspectDetails()->getResult()->getInfoTypeStats();
+            if (count($infoTypeStats) === 0) {
+                print('No findings.' . PHP_EOL);
+            } else {
+                foreach ($infoTypeStats as $infoTypeStat) {
+                    printf(
+                        '  Found %s instance(s) of infoType %s' . PHP_EOL,
+                        $infoTypeStat->getCount(),
+                        $infoTypeStat->getInfoType()->getName()
+                    );
+                }
+            }
+            break;
+        case JobState::FAILED:
+            printf('Job %s had errors:' . PHP_EOL, $job->getName());
+            $errors = $job->getErrors();
+            foreach ($errors as $error) {
+                var_dump($error->getDetails());
+            }
+            break;
+        case JobState::PENDING:
+            printf('Job has not completed. Consider a longer timeout or an asynchronous execution model' . PHP_EOL);
+            break;
+        default:
+            print('Unexpected job state. Most likely, the job is either running or has not yet started.' . PHP_EOL);
+    }
+}
+# [END dlp_deidentify_cloud_storage]
