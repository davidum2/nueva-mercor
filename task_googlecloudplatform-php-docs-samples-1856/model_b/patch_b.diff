+namespace Google\Cloud\Samples\Dlp;
+
+# [START dlp_deidentify_cloud_storage]
+use Google\Cloud\Dlp\V2\Action;
+use Google\Cloud\Dlp\V2\Action\Deidentify;
+use Google\Cloud\Dlp\V2\BigQueryTable;
+use Google\Cloud\Dlp\V2\CloudStorageOptions;
+use Google\Cloud\Dlp\V2\CloudStorageOptions\FileSet;
+use Google\Cloud\Dlp\V2\DlpJob\JobState;
+use Google\Cloud\Dlp\V2\DlpServiceClient;
+use Google\Cloud\Dlp\V2\InspectConfig;
+use Google\Cloud\Dlp\V2\InspectJobConfig;
+use Google\Cloud\Dlp\V2\StorageConfig;
+use Google\Cloud\Dlp\V2\TransformationConfig;
+use Google\Cloud\Dlp\V2\TransformationDetailsStorageConfig;
+
+/**
+ * De-identifies files in Cloud Storage and writes the output to Cloud Storage.
+ *
+ * @param string $callingProjectId The project ID to run the API call under
+ * @param string $inputGcsPath Cloud Storage path to inspect, for example gs://bucket/path/*
+ * @param string $outputGcsPath Cloud Storage path for de-identified files, for example gs://output-bucket/path/
+ * @param string $deidentifyTemplateName Resource name of the template for unstructured files
+ * @param string $structuredDeidentifyTemplateName Resource name of the template for structured files
+ * @param string $imageRedactTemplateName Resource name of the template for images
+ * @param string $transformationDetailsTableProjectId Project containing the transformation details table
+ * @param string $transformationDetailsTableDatasetId Dataset containing the transformation details table
+ * @param string $transformationDetailsTableId BigQuery table in which to store transformation details
+ */
+function deidentify_cloud_storage(
+    string $callingProjectId,
+    string $inputGcsPath,
+    string $outputGcsPath,
+    string $deidentifyTemplateName,
+    string $structuredDeidentifyTemplateName,
+    string $imageRedactTemplateName,
+    string $transformationDetailsTableProjectId,
+    string $transformationDetailsTableDatasetId,
+    string $transformationDetailsTableId
+): void {
+    $dlp = new DlpServiceClient();
+
+    try {
+        $storageConfig = (new StorageConfig())
+            ->setCloudStorageOptions(
+                (new CloudStorageOptions())
+                    ->setFileSet((new FileSet())->setUrl($inputGcsPath))
+            );
+
+        $transformationConfig = (new TransformationConfig())
+            ->setDeidentifyTemplate($deidentifyTemplateName)
+            ->setStructuredDeidentifyTemplate($structuredDeidentifyTemplateName)
+            ->setImageRedactTemplate($imageRedactTemplateName);
+
+        $transformationDetailsTable = (new BigQueryTable())
+            ->setProjectId($transformationDetailsTableProjectId)
+            ->setDatasetId($transformationDetailsTableDatasetId)
+            ->setTableId($transformationDetailsTableId);
+        $transformationDetailsStorageConfig = (new TransformationDetailsStorageConfig())
+            ->setTable($transformationDetailsTable);
+
+        $deidentify = (new Deidentify())
+            ->setTransformationConfig($transformationConfig)
+            ->setTransformationDetailsStorageConfig($transformationDetailsStorageConfig)
+            ->setCloudStorageOutput($outputGcsPath);
+        $action = (new Action())->setDeidentify($deidentify);
+
+        $inspectJob = (new InspectJobConfig())
+            ->setStorageConfig($storageConfig)
+            ->setInspectConfig(new InspectConfig())
+            ->setActions([$action]);
+
+        $parent = "projects/$callingProjectId/locations/global";
+        $job = $dlp->createDlpJob($parent, [
+            'inspectJob' => $inspectJob,
+        ]);
+
+        // Poll until the asynchronous inspection and de-identification job finishes.
+        while (in_array($job->getState(), [JobState::PENDING, JobState::RUNNING], true)) {
+            sleep(10);
+            $job = $dlp->getDlpJob($job->getName());
+        }
+
+        printf('Job name: %s' . PHP_EOL, $job->getName());
+
+        if ($job->getState() !== JobState::DONE) {
+            printf('Job status: %s' . PHP_EOL, JobState::name($job->getState()));
+            foreach ($job->getErrors() as $error) {
+                printf('Error: %s' . PHP_EOL, $error->getDetails()->getMessage());
+            }
+            return;
+        }
+
+        $infoTypeStats = $job->getInspectDetails()->getResult()->getInfoTypeStats();
+        if (count($infoTypeStats) === 0) {
+            print('No findings.' . PHP_EOL);
+            return;
+        }
+
+        foreach ($infoTypeStats as $infoTypeStat) {
+            printf(
+                'Found %s instance(s) of infoType %s' . PHP_EOL,
+                $infoTypeStat->getCount(),
+                $infoTypeStat->getInfoType()->getName()
+            );
+        }
+    } finally {
+        $dlp->close();
+    }
+}
+# [END dlp_deidentify_cloud_storage]
