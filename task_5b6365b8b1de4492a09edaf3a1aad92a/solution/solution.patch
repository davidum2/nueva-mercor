+from dataclasses import dataclass
+from typing import Tuple, Dict, Any, Union, Optional
+
+
+class UnsupportedSignalError(Exception):
+    def __init__(self, signal_name: str):
+        super().__init__(f"Unsupported signal: {signal_name}")
+        self.signal_name = signal_name
+
+
+@dataclass(frozen=True)
+class SignalLayout:
+    slices: Tuple[Tuple[int, int, int], ...]
+    bit_width: int
+
+
+def signal_layout(signal: dict, dlc: int) -> SignalLayout:
+    sig_name = signal.get("name", "unknown")
+    bit_width = signal.get("len", 0)
+    if bit_width > 32:
+        raise UnsupportedSignalError(sig_name)
+
+    bit = signal.get("bit", 0)
+    order = signal.get("order", "intel")
+
+    left_len = bit_width
+    byte_idx = bit // 8
+    bit_start = bit % 8
+    slices = []
+
+    if order == "motorola":
+        while left_len > 0:
+            if byte_idx < 0 or byte_idx >= dlc:
+                raise UnsupportedSignalError(sig_name)
+            slice_len = min(bit_start + 1, left_len)
+            start_pos = bit_start - slice_len + 1
+            slices.append((byte_idx, start_pos, slice_len))
+            left_len -= slice_len
+            byte_idx += 1
+            bit_start = 7
+    else:
+        while left_len > 0:
+            if byte_idx < 0 or byte_idx >= dlc:
+                raise UnsupportedSignalError(sig_name)
+            slice_len = min(8 - bit_start, left_len)
+            slices.append((byte_idx, bit_start, slice_len))
+            left_len -= slice_len
+            byte_idx += 1
+            bit_start = 0
+        slices.reverse()
+
+    return SignalLayout(tuple(slices), bit_width)
+
+
+RANG_MASK_1_L = [0x01, 0x03, 0x07, 0x0F, 0x1F, 0x3F, 0x7F, 0xFF]
+RANG_MASK_0_L = [0xFE, 0xFC, 0xF8, 0xF0, 0xE0, 0xC0, 0x80, 0x00]
+
+
+def byte_set_value(buffer: bytearray, byte_idx: int, value: int, start_pos: int, length: int):
+    if start_pos > 7 or start_pos < 0 or length < 1:
+        return
+    end_pos = min(start_pos + length - 1, 7)
+    real_len = end_pos + 1 - start_pos
+    current_val = buffer[byte_idx]
+    low = current_val & RANG_MASK_1_L[start_pos - 1] if start_pos > 0 else 0x00
+    high = current_val & RANG_MASK_0_L[end_pos]
+    middle = (value & RANG_MASK_1_L[real_len - 1]) << start_pos
+    buffer[byte_idx] = (high + middle + low) & 0xFF
+
+
+def get_range_info(var: dict) -> Optional[Dict[str, float]]:
+    if "physical_range" not in var:
+        return None
+    pr = var["physical_range"]
+    if '|' not in pr or '[' not in pr or ']' not in pr:
+        return None
+    try:
+        items = pr.split('|')
+        low_str = items[0].split('[')[1]
+        high_str = items[1].split(']')[0]
+        return {"low": float(low_str), "high": float(high_str)}
+    except Exception:
+        return None
+
+
+class FrameCodec:
+    def __init__(self, protocol: dict):
+        self.dlc = protocol.get("dlc", 8)
+        self.name = protocol.get("name", "")
+        self.protocol_type = protocol.get("protocol_type", "")
+        self.vars = protocol.get("vars", [])
+        self._vars_by_name = {v["name"]: v for v in self.vars}
+        self._layouts = {}
+
+        for v in self.vars:
+            layout = signal_layout(v, self.dlc)
+            self._layouts[v["name"]] = layout
+
+    def layout(self, name: str) -> SignalLayout:
+        if name not in self._layouts:
+            raise KeyError(name)
+        return self._layouts[name]
+
+    def decode(self, data: bytes) -> Dict[str, Union[bool, int, float]]:
+        if len(data) < self.dlc:
+            raise ValueError(f"Data length {len(data)} is less than DLC {self.dlc}")
+
+        result = {}
+        for var in self.vars:
+            name = var["name"]
+            slayout = self._layouts[name]
+            x = 0
+            for byte_idx, start_pos, slice_len in slayout.slices:
+                t = (data[byte_idx] >> start_pos) & ((1 << slice_len) - 1)
+                x = ((x << slice_len) | t) & 0xFFFFFFFF
+
+            shift_bit = 32 - var["len"]
+            if var.get("is_signed_var", False):
+                x = (x << shift_bit) & 0xFFFFFFFF
+                if x & 0x80000000:
+                    x = x - 0x100000000
+                x >>= shift_bit
+
+            returntype = var.get("type", "int")
+            if returntype == "bool":
+                result[name] = bool(x != 0)
+            elif returntype == "enum":
+                result[name] = int(x)
+            else:
+                prec = var.get("precision", 1.0)
+                offset = var.get("offset", 0.0)
+                val = x * prec + offset
+                if returntype == "double" or prec != 1.0 or offset != 0.0 or isinstance(val, float):
+                    if returntype == "int":
+                        result[name] = int(val)
+                    else:
+                        result[name] = float(val)
+                else:
+                    result[name] = int(val)
+
+        return result
+
+    def encode(self, values: Optional[dict] = None, data: Optional[bytes] = None) -> bytes:
+        if data is not None:
+            if len(data) < self.dlc:
+                raise ValueError(f"Initial data length {len(data)} is less than DLC {self.dlc}")
+            buffer = bytearray(data[: self.dlc])
+        else:
+            buffer = bytearray(self.dlc)
+
+        if values is None:
+            values = {}
+
+        for k in values:
+            if k not in self._vars_by_name:
+                raise KeyError(k)
+
+        for var in self.vars:
+            self._encode_signal(buffer, var, values)
+
+        return bytes(buffer)
+
+    def _encode_signal(self, buffer: bytearray, var: dict, values: dict):
+        name = var["name"]
+        if name in values:
+            val = values[name]
+        else:
+            vtype = var.get("type", "int")
+            if vtype == "bool":
+                val = False
+            elif vtype == "enum":
+                enum_map = var.get("enum", {})
+                if 0 in enum_map or "0" in enum_map:
+                    val = 0
+                elif enum_map:
+                    first_key = next(iter(enum_map.keys()))
+                    try:
+                        val = int(first_key)
+                    except (ValueError, TypeError):
+                        val = 0
+                else:
+                    val = 0
+            else:
+                val = 0
+
+        range_info = get_range_info(var)
+        if range_info:
+            low = range_info["low"]
+            high = range_info["high"]
+            if low <= high:
+                if val < low:
+                    val = low
+                elif val > high:
+                    val = high
+
+        prec = var.get("precision", 1.0)
+        offset = var.get("offset", 0.0)
+        raw_val = (val - offset) / prec
+        x = int(raw_val)
+
+        lsb_first_slices = list(reversed(self._layouts[name].slices))
+        if len(lsb_first_slices) == 1:
+            byte_idx, start_pos, slice_len = lsb_first_slices[0]
+            byte_set_value(buffer, byte_idx, x & 0xFF, start_pos, slice_len)
+        else:
+            prev_len = 0
+            for i, (byte_idx, start_pos, slice_len) in enumerate(lsb_first_slices):
+                if i != 0:
+                    x >>= prev_len
+                slice_mask = (1 << slice_len) - 1
+                t = x & slice_mask
+                byte_set_value(buffer, byte_idx, t, start_pos, slice_len)
+                prev_len = slice_len
+
+    def quantize(self, values: Optional[dict] = None) -> Dict[str, Union[bool, int, float]]:
+        if values is None:
+            values = {}
+
+        res = {}
+        for var in self.vars:
+            # each signal goes onto a zeroed frame of its own
+            buffer = bytearray(self.dlc)
+            self._encode_signal(buffer, var, values)
+            res[var["name"]] = self.decode(bytes(buffer))[var["name"]]
+
+        return res
