+  /**
+   * A value-based RANGE frame.  The frame of a row is the set of rows whose value in the single ordering
+   * column falls between the current row's value plus the lower offset and the current row's value plus the
+   * upper offset.  A null offset means the frame is unbounded (positionally) on that side.  Rows whose
+   * ordering value is null resolve finite bounds to the edges of the contiguous run of null values.
+   */
+  class Range implements WindowFrame
+  {
+    @JsonProperty
+    private final Double lowerOffset;
+    @JsonProperty
+    private final Double upperOffset;
+    @JsonProperty
+    private final ColumnWithDirection orderBy;
+
+    @JsonCreator
+    public Range(
+        @JsonProperty("lowerOffset") @Nullable Double lowerOffset,
+        @JsonProperty("upperOffset") @Nullable Double upperOffset,
+        @JsonProperty("orderBy") ColumnWithDirection orderBy
+    )
+    {
+      this.lowerOffset = lowerOffset;
+      this.upperOffset = upperOffset;
+      this.orderBy = orderBy;
+    }
+
+    @Nullable
+    public Double getLowerOffset()
+    {
+      return lowerOffset;
+    }
+
+    @Nullable
+    public Double getUpperOffset()
+    {
+      return upperOffset;
+    }
+
+    public ColumnWithDirection getOrderBy()
+    {
+      return orderBy;
+    }
+
+    @Override
+    public int hashCode()
+    {
+      return Objects.hash(lowerOffset, upperOffset, orderBy);
+    }
+
+    @Override
+    public boolean equals(Object obj)
+    {
+      if (this == obj) {
+        return true;
+      }
+      if (obj == null) {
+        return false;
+      }
+      if (getClass() != obj.getClass()) {
+        return false;
+      }
+      Range other = (Range) obj;
+      return Objects.equals(lowerOffset, other.lowerOffset)
+          && Objects.equals(upperOffset, other.upperOffset)
+          && Objects.equals(orderBy, other.orderBy);
+    }
+
+    @Override
+    public String toString()
+    {
+      return "WindowFrame.Range [" +
+          "lowerOffset=" + lowerOffset +
+          ", upperOffset=" + upperOffset +
+          ", orderBy=" + orderBy + "]";
+    }
+  }
+
