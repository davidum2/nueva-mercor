+package org.apache.druid.query.operator.window;
+
+import com.google.common.collect.ImmutableList;
+import org.apache.druid.error.DruidException;
+import org.apache.druid.query.rowsandcols.RowsAndColumns;
+import org.apache.druid.query.rowsandcols.column.Column;
+import org.apache.druid.query.rowsandcols.column.ColumnAccessor;
+import org.apache.druid.query.rowsandcols.semantic.ClusteredGroupPartitioner;
+
+/**
+ * Resolves the frame boundaries of a value-based {@link WindowFrame.Range} frame.
+ * <p>
+ * The input must already be sorted, within each partition, by the ordering column of the frame.  Rows whose
+ * ordering value is null are expected to be clustered at the start (ascending) or end (descending) of the
+ * partition, as produced by the standard sort machinery.
+ * <p>
+ * Rows are grouped into peer groups (rows that share the same ordering value).  All rows of a peer group get
+ * the same frame: the contiguous run of rows whose value falls between the current row's value plus the
+ * lower offset and the current row's value plus the upper offset.  A row whose ordering value is null
+ * resolves any finite bound to the corresponding edge of the null run.
+ */
+public class RangeFrameResolver
+{
+  /**
+   * Boundary positions of the peer groups; group {@code g} covers rows [{@code groupBoundaries[g]},
+   * {@code groupBoundaries[g + 1]}).
+   */
+  private final int[] groupBoundaries;
+  /**
+   * Frame start (inclusive) of each peer group.
+   */
+  private final int[] frameStarts;
+  /**
+   * Frame end (exclusive, never smaller than the frame start) of each peer group.
+   */
+  private final int[] frameEnds;
+
+  public RangeFrameResolver(final RowsAndColumns rac, final WindowFrame.Range frame)
+  {
+    final String orderColumn = frame.getOrderBy().getColumn();
+    final Column orderColumnObj = rac.findColumn(orderColumn);
+    if (orderColumnObj == null) {
+      throw DruidException.defensive(
+          "Column [%s] specified in WindowFrame [%s] does not exist",
+          orderColumn,
+          frame
+      );
+    }
+    final ColumnAccessor accessor = orderColumnObj.toAccessor();
+    final int numRows = accessor.numRows();
+
+    final boolean hasFiniteBound = frame.getLowerOffset() != null || frame.getUpperOffset() != null;
+    if (hasFiniteBound && !accessor.getType().isNumeric()) {
+      throw DruidException.defensive(
+          "WindowFrame [%s] requires a numeric ordering column, found column [%s] of type [%s]",
+          frame,
+          orderColumn,
+          accessor.getType()
+      );
+    }
+
+    this.groupBoundaries = ClusteredGroupPartitioner.fromRAC(rac).computeBoundaries(ImmutableList.of(orderColumn));
+    final int numGroups = groupBoundaries.length == 0 ? 0 : groupBoundaries.length - 1;
+    this.frameStarts = new int[numGroups];
+    this.frameEnds = new int[numGroups];
+
+    final boolean ascending = frame.getOrderBy().getDirection()
+                                                     .getDirectionInt() > 0;
+    final Double lowerOffset = frame.getLowerOffset();
+    final Double upperOffset = frame.getUpperOffset();
+
+    // Null values sort before all non-null values when ascending and after all non-null values when
+    // descending, so the null run is a prefix (ascending) or suffix (descending) of the partition.
+    final int nullRunStart;
+    final int nullRunEnd;
+    if (ascending) {
+      nullRunStart = 0;
+      nullRunEnd = countLeadingNulls(accessor, numRows);
+    } else {
+      nullRunEnd = numRows;
+      nullRunStart = numRows - countTrailingNulls(accessor, numRows);
+    }
+
+    for (int g = 0; g < numGroups; g++) {
+      final int groupStart = groupBoundaries[g];
+      if (accessor.isNull(groupStart)) {
+        // The current row's value is null; finite bounds resolve to the edges of the null run.
+        frameStarts[g] = lowerOffset == null ? 0 : nullRunStart;
+        frameEnds[g] = upperOffset == null ? numRows : nullRunEnd;
+        continue;
+      }
+
+      final double value = accessor.getDouble(groupStart);
+      if (ascending) {
+        frameStarts[g] = lowerOffset == null
+                        ? 0
+                        : lowerBoundAscending(accessor, nullRunEnd, numRows, value + lowerOffset);
+        frameEnds[g] = upperOffset == null
+                        ? numRows
+                        : upperBoundAscending(accessor, nullRunEnd, numRows, value + upperOffset);
+      } else {
+        frameStarts[g] = lowerOffset == null
+                        ? 0
+                        : lowerBoundDescending(accessor, 0, nullRunStart, value - lowerOffset);
+        frameEnds[g] = upperOffset == null
+                        ? numRows
+                        : upperBoundDescending(accessor, 0, nullRunStart, value - upperOffset);
+      }
+      // The frame can be empty (and the bounds can even be inverted) if the offset interval does not
+      // contain any value; normalize so that the frame end is never before the frame start.
+      frameEnds[g] = Math.max(frameStarts[g], frameEnds[g]);
+    }
+  }
+
+  public int getNumGroups()
+  {
+    return groupBoundaries.length == 0 ? 0 : groupBoundaries.length - 1;
+  }
+
+  /**
+   * First row (inclusive) of peer group {@code group}.
+   */
+  public int getGroupStart(int group)
+  {
+    return groupBoundaries[group];
+  }
+
+  /**
+   * One past the last row (exclusive) of peer group {@code group}.
+   */
+  public int getGroupEnd(int group)
+  {
+    return groupBoundaries[group + 1];
+  }
+
+  /**
+   * First row (inclusive) of the frame of peer group {@code group}.
+   */
+  public int getFrameStart(int group)
+  {
+    return frameStarts[group];
+  }
+
+  /**
+   * One past the last row (exclusive) of the frame of peer group {@code group}.
+   */
+  public int getFrameEnd(int group)
+  {
+    return frameEnds[group];
+  }
+
+  private static int countLeadingNulls(final ColumnAccessor accessor, final int numRows)
+  {
+    int nulls = 0;
+    while (nulls < numRows && accessor.isNull(nulls)) {
+      nulls++;
+    }
+    return nulls;
+  }
+
+  private static int countTrailingNulls(final ColumnAccessor accessor, final int numRows)
+  {
+    int nulls = 0;
+    while (nulls < numRows && accessor.isNull(numRows - 1 - nulls)) {
+      nulls++;
+    }
+    return nulls;
+  }
+
+  /**
+   * First row in [{@code lo}, {@code hi}) whose value is at least {@code target}, assuming the region is
+   * sorted ascending.  Returns {@code hi} if there is no such row.
+   */
+  private static int lowerBoundAscending(
+      final ColumnAccessor accessor,
+      final int lo,
+      final int hi,
+      final double target
+  )
+  {
+    int low = lo;
+    int high = hi;
+    while (low < high) {
+      final int mid = (low + high) >>> 1;
+      if (accessor.getDouble(mid) < target) {
+        low = mid + 1;
+      } else {
+        high = mid;
+      }
+    }
+    return low;
+  }
+
+  /**
+   * First row in [{@code lo}, {@code hi}) whose value is greater than {@code target}, assuming the region is
+   * sorted ascending.  Returns {@code hi} if there is no such row.
+   */
+  private static int upperBoundAscending(
+      final ColumnAccessor accessor,
+      final int lo,
+      final int hi,
+      final double target
+  )
+  {
+    int low = lo;
+    int high = hi;
+    while (low < high) {
+      final int mid = (low + high) >>> 1;
+      if (accessor.getDouble(mid) <= target) {
+        low = mid + 1;
+      } else {
+        high = mid;
+      }
+    }
+    return low;
+  }
+
+  /**
+   * First row in [{@code lo}, {@code hi}) whose value is at most {@code target}, assuming the region is
+   * sorted descending.  Returns {@code hi} if there is no such row.
+   */
+  private static int lowerBoundDescending(
+      final ColumnAccessor accessor,
+      final int lo,
+      final int hi,
+      final double target
+  )
+  {
+    int low = lo;
+    int high = hi;
+    while (low < high) {
+      final int mid = (low + high) >>> 1;
+      if (accessor.getDouble(mid) > target) {
+        low = mid + 1;
+      } else {
+        high = mid;
+      }
+    }
+    return low;
+  }
+
+  /**
+   * First row in [{@code lo}, {@code hi}) whose value is less than {@code target}, assuming the region is
+   * sorted descending.  Returns {@code hi} if there is no such row.
+   */
+  private static int upperBoundDescending(
+      final ColumnAccessor accessor,
+      final int lo,
+      final int hi,
+      final double target
+  )
+  {
+    int low = lo;
+    int high = hi;
+    while (low < high) {
+      final int mid = (low + high) >>> 1;
+      if (accessor.getDouble(mid) >= target) {
+        low = mid + 1;
+      } else {
+        high = mid;
+      }
+    }
+    return low;
+  }
+}
