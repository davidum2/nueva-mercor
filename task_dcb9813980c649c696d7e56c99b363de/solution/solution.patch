+   * {@code endBound} behind. A NULL ordering key never satisfies a finite bound either,
+   * so the run of NULLs that trails the values (DESC ordering) closes the frame, while
+   * the run that precedes them (ASC ordering) is simply skipped over.
+   */
+  private static int findFrameEnd(ColumnAccessor accessor, int numRows, boolean isAsc, double endBound)
+  {
+    boolean seenValue = false;
+    for (int i = 0; i < numRows; i++) {
+      if (accessor.isNull(i)) {
+        if (seenValue) {
+          return i;
+        }
+        continue;
+      }
+      seenValue = true;
+      final double value = accessor.getDouble(i);
+      if (isAsc ? value > endBound : value < endBound) {
+        return i;
+      }
+    }
+    return numRows;
+  }
