+  private static Iterable<AggInterval> buildRangeIteratorFor(AppendableRowsAndColumns rac, WindowFrame.Range rangeFrame)
+  {
+    final int numRows = rac.numRows();
+    if (numRows == 0) {
+      return Collections.emptyList();
