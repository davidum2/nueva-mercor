+  {
+    final int numRows = rac.numRows();
+    int[][] bounds = new int[numRows][2];
+    if (numRows == 0) {
+      return bounds;
+    }
+
+    Iterable<AggInterval> intervals = buildRangeIteratorFor(rac, rangeFrame);
+    for (AggInterval aggInterval : intervals) {
+      Interval in = aggInterval.inputRows;
+      Interval out = aggInterval.outputRows;
+      for (int i = out.a; i < out.b; i++) {
+        bounds[i][0] = in.a;
+        bounds[i][1] = in.b;
+      }
+    }
+    return bounds;
+  }
