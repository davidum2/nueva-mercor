+      throw DruidException.forPersona(DruidException.Persona.USER)
+          .ofCategory(DruidException.Category.INVALID_INPUT)
+          .build("Range window framing requires numeric ordering column, but column [%s] has type [%s]", orderBy.getColumn(), type);
+    }
+
+    final int[] peerBoundaries = ClusteredGroupPartitioner.fromRAC(rac).computeBoundaries(Collections.singletonList(orderBy.getColumn()));
+    final int numPeers = peerBoundaries.length - 1;
+
+    // Pre-calculate frame bounds for each peer group
+    final Interval[] inputIntervals = new Interval[numPeers];
+    final boolean isAsc = orderBy.getDirection() == ColumnWithDirection.Direction.ASC;
+    final Double lowerOffset = rangeFrame.getLowerOffset();
+    final Double upperOffset = rangeFrame.getUpperOffset();
+
+    for (int p = 0; p < numPeers; p++) {
+      int firstRowInPeer = peerBoundaries[p];
+      if (accessor.isNull(firstRowInPeer)) {
+        int lowerBound = (lowerOffset == null) ? 0 : peerBoundaries[p];
+        int upperBound = (upperOffset == null) ? numRows : peerBoundaries[p + 1];
+        inputIntervals[p] = Interval.of(lowerBound, upperBound);
