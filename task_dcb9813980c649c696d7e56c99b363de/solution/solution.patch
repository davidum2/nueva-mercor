+  /**
+   * First row (inclusive) of a value based frame: the first row whose non-null ordering
+   * value has already reached {@code startBound}. Rows with a NULL ordering key never
+   * satisfy a finite bound, so they are skipped.
+   */
+  private static int findFrameStart(ColumnAccessor accessor, int numRows, boolean isAsc, double startBound)
+  {
+    for (int i = 0; i < numRows; i++) {
+      if (accessor.isNull(i)) {
+        continue;
+      }
+      final double value = accessor.getDouble(i);
+      if (isAsc ? value >= startBound : value <= startBound) {
+        return i;
+      }
+    }
+    return numRows;
+  }
+
+  /**
