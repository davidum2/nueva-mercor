+        return None
+
+    def on_skipped(self, data_id=0, log_id=0):
+        return None
+
+    def get_succ_op_names(self):
+        return set(self._succ_op_names)
+
+    def get_pred_op_names(self):
+        return set(self._pred_op_names)
+
+    def _resolve_route(self, output_data, data_id, log_id):
+        """
+        Ask route() which successors stay active for one request.
+
+        Returns:
+            targets: None (all successors) or a set of successor names
+            error_code: None if the routing decision is usable
+            error_info: error message
+        """
+        log_prefix = "(data_id={} log_id={}) {}".format(data_id, log_id,
+                                                        self.name)
+        try:
+            targets = self.route(output_data, data_id=data_id, log_id=log_id)
+        except Exception as e:
+            error_info = "{} Failed to route: {}".format(log_prefix, e)
+            _LOGGER.error(error_info, exc_info=True)
+            return None, ChannelDataErrcode.UNKNOW.value, error_info
+        if targets is None:
+            return None, None, ""
+        if isinstance(targets, str):
+            targets = [targets]
+        try:
+            # route() may hand back a one-shot iterable, read it only once
+            targets = list(targets)
+        except Exception as e:
+            error_info = "{} route() must return None or an iterable of " \
+                "successor names: {}".format(log_prefix, e)
+            _LOGGER.error(error_info)
+            return None, ChannelDataErrcode.INPUT_PARAMS_ERROR.value, error_info
+        unknown = [
+            x for x in targets
+            if not isinstance(x, str) or x not in self._succ_op_names
+        ]
+        if len(unknown) > 0:
+            error_info = "{} route() returned non-successor op(s): {}".format(
+                log_prefix, unknown)
+            _LOGGER.error(error_info)
+            return None, ChannelDataErrcode.INPUT_PARAMS_ERROR.value, error_info
+        return set(targets), None, ""
+
+    def _is_active_for_request(self, channeldata_dict):
+        """
+        An op runs for a request if any producer routed the request to it.
+        Upstream errors always count, so they keep flowing downstream.
+        """
+        active = False
+        for channeldata in channeldata_dict.values():
+            if channeldata.is_skipped():
+                continue
+            if channeldata.error_code != ChannelDataErrcode.OK.value:
+                return True
+            active_succs = getattr(channeldata, "_active_successors", None)
+            if active_succs is None or self.name in active_succs:
+                active = True
+        return active
 
