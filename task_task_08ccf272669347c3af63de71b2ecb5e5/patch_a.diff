+import { auto, IServiceProvider, module } from 'angular';
+import { uniq } from 'lodash';
+
+import { IExpectedArtifact, IPipeline, IStage } from 'core/domain';
+
+export class ArtifactReferenceServiceProvider implements IServiceProvider {
+  private $injector: auto.IInjectorService;
+  private referencePaths: Map<string, Set<string>> = new Map<string, Set<string>>();
+
+  public $get($injector?: auto.IInjectorService): ArtifactReferenceServiceProvider {
+    if ($injector) {
+      this.$injector = $injector;
+    }
+    return this;
+  }
+
+  public registerReferencePath(stageType: string, path: string): void {
+    if (!stageType || !path) {
+      return;
+    }
+    if (!this.referencePaths.has(stageType)) {
+      this.referencePaths.set(stageType, new Set<string>());
+    }
+    this.referencePaths.get(stageType).add(path);
+  }
+
+  public registerReferencePaths(stageType: string, paths: string[]): void {
+    if (!stageType || !paths) {
+      return;
+    }
+    paths.forEach((path: string) => this.registerReferencePath(stageType, path));
+  }
+
+  public register(stageType: string, paths: string | string[]): void {
+    if (Array.isArray(paths)) {
+      this.registerReferencePaths(stageType, paths);
+    } else {
+      this.registerReferencePath(stageType, paths);
+    }
+  }
+
+  public registerArtifactReference(stageType: string, path: string): void {
+    this.registerReferencePath(stageType, path);
+  }
+
+  public registerArtifactReferences(stageType: string, paths: string[]): void {
+    this.registerReferencePaths(stageType, paths);
+  }
+
+  public registerReference(stageType: string, path: string): void {
+    this.registerReferencePath(stageType, path);
+  }
+
+  public registerPath(stageType: string, path: string): void {
+    this.registerReferencePath(stageType, path);
+  }
+
+  public registerPaths(stageType: string, paths: string[]): void {
+    this.registerReferencePaths(stageType, paths);
+  }
+
+  public getRegisteredReferencePaths(stageType: string): string[] {
+    const paths: string[] = [];
+    if (this.referencePaths.has(stageType)) {
+      paths.push(...Array.from(this.referencePaths.get(stageType)));
+    }
+    if (stageType !== '*' && this.referencePaths.has('*')) {
+      paths.push(...Array.from(this.referencePaths.get('*')));
+    }
+    if (this.$injector && this.$injector.has('pipelineConfig')) {
+      try {
+        const pipelineConfig = this.$injector.get<any>('pipelineConfig');
+        const stageConfig = pipelineConfig.getStageConfig({ type: stageType });
+        if (stageConfig) {
+          if (stageConfig.provides && this.referencePaths.has(stageConfig.provides)) {
+            paths.push(...Array.from(this.referencePaths.get(stageConfig.provides)));
+          }
+          if (stageConfig.alias && this.referencePaths.has(stageConfig.alias)) {
+            paths.push(...Array.from(this.referencePaths.get(stageConfig.alias)));
+          }
+          if (stageConfig.artifactReferenceFields && Array.isArray(stageConfig.artifactReferenceFields)) {
+            paths.push(...stageConfig.artifactReferenceFields);
+          }
+        }
+      } catch (e) {
+        // Fall back to registered paths
+      }
+    }
+    return uniq(paths);
+  }
+
+  public getReferencePaths(stageType?: string): string[] | { [stageType: string]: string[] } {
+    if (stageType) {
+      return this.getRegisteredReferencePaths(stageType);
+    }
+    const result: { [stageType: string]: string[] } = {};
+    this.referencePaths.forEach((paths: Set<string>, key: string) => {
+      result[key] = Array.from(paths);
+    });
+    return result;
+  }
+
+  public getReferencePathsForStageType(stageType: string): string[] {
+    return this.getRegisteredReferencePaths(stageType);
+  }
+
+  public getReferencesFor(stageType: string): string[] {
+    return this.getRegisteredReferencePaths(stageType);
+  }
+
+  public hasReferencePaths(stageType: string): boolean {
+    return this.getRegisteredReferencePaths(stageType).length > 0;
+  }
+
+  public hasReference(stageType: string): boolean {
+    return this.hasReferencePaths(stageType);
+  }
+
+  private extractArtifactId(expectedArtifact: string | IExpectedArtifact): string {
+    if (!expectedArtifact) {
+      return null;
+    }
+    if (typeof expectedArtifact === 'string') {
+      return expectedArtifact;
+    }
+    if (typeof expectedArtifact === 'object' && expectedArtifact.id) {
+      return expectedArtifact.id;
+    }
+    return null;
+  }
+
+  public removeArtifactFromPipeline(pipelineOrArtifact: IPipeline | string | IExpectedArtifact, artifactOrPipeline?: IPipeline | string | IExpectedArtifact): void {
+    let pipeline: IPipeline = null;
+    let artifact: string | IExpectedArtifact = null;
+
+    if (pipelineOrArtifact && typeof pipelineOrArtifact === 'object' && (pipelineOrArtifact as IPipeline).stages) {
+      pipeline = pipelineOrArtifact as IPipeline;
+      artifact = artifactOrPipeline;
+    } else if (artifactOrPipeline && typeof artifactOrPipeline === 'object' && (artifactOrPipeline as IPipeline).stages) {
+      pipeline = artifactOrPipeline as IPipeline;
+      artifact = pipelineOrArtifact;
+    } else if (pipelineOrArtifact && typeof pipelineOrArtifact === 'object' && !('id' in pipelineOrArtifact) && !('type' in pipelineOrArtifact)) {
+      pipeline = pipelineOrArtifact as IPipeline;
+      artifact = artifactOrPipeline;
+    } else {
+      artifact = pipelineOrArtifact;
+      pipeline = artifactOrPipeline as IPipeline;
+    }
+
+    const artifactId: string = this.extractArtifactId(artifact);
+    if (!artifactId || !pipeline || !pipeline.stages || !Array.isArray(pipeline.stages)) {
+      return;
+    }
+
+    this.removeArtifactFromStages(artifactId, pipeline.stages);
+  }
+
+  public removeArtifactFromStages(artifactOrStages: string | IExpectedArtifact | IStage[], stagesOrArtifact?: string | IExpectedArtifact | IStage[]): void {
+    let stages: IStage[] = null;
+    let artifact: string | IExpectedArtifact = null;
+
+    if (Array.isArray(artifactOrStages)) {
+      stages = artifactOrStages;
+      artifact = stagesOrArtifact as string | IExpectedArtifact;
+    } else if (Array.isArray(stagesOrArtifact)) {
+      stages = stagesOrArtifact;
+      artifact = artifactOrStages;
+    }
+
+    const artifactId: string = this.extractArtifactId(artifact);
+    if (!artifactId || !stages || !Array.isArray(stages)) {
+      return;
+    }
+
+    stages.forEach((stage: IStage) => this.removeArtifactFromStage(artifactId, stage));
+  }
+
+  public removeArtifactFromStage(artifactOrStage: string | IExpectedArtifact | IStage, stageOrArtifact?: string | IExpectedArtifact | IStage): void {
+    let stage: IStage = null;
+    let artifact: string | IExpectedArtifact = null;
+
+    if (artifactOrStage && typeof artifactOrStage === 'object' && ('type' in artifactOrStage)) {
+      stage = artifactOrStage as IStage;
+      artifact = stageOrArtifact as string | IExpectedArtifact;
+    } else if (stageOrArtifact && typeof stageOrArtifact === 'object' && ('type' in stageOrArtifact)) {
+      stage = stageOrArtifact as IStage;
+      artifact = artifactOrStage;
+    }
+
+    const artifactId: string = this.extractArtifactId(artifact);
+    if (!artifactId || !stage || !stage.type) {
+      return;
+    }
+
+    const paths: string[] = this.getRegisteredReferencePaths(stage.type);
+    if (!paths || paths.length === 0) {
+      return;
+    }
+
+    paths.forEach((path: string) => this.removeReferencePath(stage, path, artifactId));
+  }
+
+  public removeArtifactReferences(artifactOrPipeline: string | IExpectedArtifact | IPipeline, pipelineOrArtifact?: IPipeline | string | IExpectedArtifact): void {
+    this.removeArtifactFromPipeline(artifactOrPipeline, pipelineOrArtifact);
+  }
+
+  public removeArtifactReferenceFromPipeline(artifactOrPipeline: string | IExpectedArtifact | IPipeline, pipelineOrArtifact?: IPipeline | string | IExpectedArtifact): void {
+    this.removeArtifactFromPipeline(artifactOrPipeline, pipelineOrArtifact);
+  }
+
+  public removeArtifact(artifactOrPipeline: string | IExpectedArtifact | IPipeline, pipelineOrArtifact?: IPipeline | string | IExpectedArtifact): void {
+    this.removeArtifactFromPipeline(artifactOrPipeline, pipelineOrArtifact);
+  }
+
+  public removeReferenceFromPipeline(artifactOrPipeline: string | IExpectedArtifact | IPipeline, pipelineOrArtifact?: IPipeline | string | IExpectedArtifact): void {
+    this.removeArtifactFromPipeline(artifactOrPipeline, pipelineOrArtifact);
+  }
+
+  public removeArtifactReference(artifactOrPipeline: string | IExpectedArtifact | IPipeline, pipelineOrArtifact?: IPipeline | string | IExpectedArtifact): void {
+    this.removeArtifactFromPipeline(artifactOrPipeline, pipelineOrArtifact);
+  }
+
+  public removeArtifactReferenceFromStages(artifactOrStages: string | IExpectedArtifact | IStage[], stagesOrArtifact?: string | IExpectedArtifact | IStage[]): void {
+    this.removeArtifactFromStages(artifactOrStages, stagesOrArtifact);
+  }
+
+  public removeArtifactReferenceFromStage(artifactOrStage: string | IExpectedArtifact | IStage, stageOrArtifact?: string | IExpectedArtifact | IStage): void {
+    this.removeArtifactFromStage(artifactOrStage, stageOrArtifact);
+  }
+
+  public removeReferenceFromStage(artifactOrStage: string | IExpectedArtifact | IStage, stageOrArtifact?: string | IExpectedArtifact | IStage): void {
+    this.removeArtifactFromStage(artifactOrStage, stageOrArtifact);
+  }
+
+  public sweepArtifact(artifactOrPipeline: string | IExpectedArtifact | IPipeline, pipelineOrArtifact?: IPipeline | string | IExpectedArtifact): void {
+    this.removeArtifactFromPipeline(artifactOrPipeline, pipelineOrArtifact);
+  }
+
+  public sweepArtifactReferences(artifactOrPipeline: string | IExpectedArtifact | IPipeline, pipelineOrArtifact?: IPipeline | string | IExpectedArtifact): void {
+    this.removeArtifactFromPipeline(artifactOrPipeline, pipelineOrArtifact);
+  }
+
+  public cleanArtifactReferences(artifactOrPipeline: string | IExpectedArtifact | IPipeline, pipelineOrArtifact?: IPipeline | string | IExpectedArtifact): void {
+    this.removeArtifactFromPipeline(artifactOrPipeline, pipelineOrArtifact);
+  }
+
+  public sweep(artifactOrPipeline: string | IExpectedArtifact | IPipeline, pipelineOrArtifact?: IPipeline | string | IExpectedArtifact): void {
+    this.removeArtifactFromPipeline(artifactOrPipeline, pipelineOrArtifact);
+  }
+
+  private normalizePath(path: string): string[] {
+    if (!path) {
+      return [];
+    }
+    const normalized: string = path
+      .replace(/\[(\d+)\]/g, '.$1')
+      .replace(/\[\*\]/g, '.*')
+      .replace(/\[\]/g, '.*');
+    return normalized.split('.').filter((p: string) => p.length > 0);
+  }
+
+  public removeReferencePath(stage: IStage, path: string, artifactId: string): void {
+    const tokens: string[] = this.normalizePath(path);
+    if (tokens.length === 0) {
+      return;
+    }
+    this.removePathFromObject(stage, tokens, artifactId);
+  }
+
+  private matchesArtifactId(item: any, artifactId: string): boolean {
+    if (item === artifactId) {
+      return true;
+    }
+    if (item && typeof item === 'object') {
+      return item.id === artifactId || item.expectedArtifactId === artifactId || item.artifactId === artifactId;
+    }
+    return false;
+  }
+
+  private removePathFromObject(obj: any, tokens: string[], artifactId: string): void {
+    if (!obj || typeof obj !== 'object' || !tokens || tokens.length === 0) {
+      return;
+    }
+
+    if (tokens.length === 1) {
+      const lastToken: string = tokens[0];
+      if (lastToken === '*' || lastToken === '[]') {
+        if (Array.isArray(obj)) {
+          for (let i = obj.length - 1; i >= 0; i--) {
+            if (this.matchesArtifactId(obj[i], artifactId)) {
+              obj.splice(i, 1);
+            }
+          }
+        }
+        return;
+      }
+
+      if (Array.isArray(obj)) {
+        const index: number = parseInt(lastToken, 10);
+        if (!isNaN(index) && index >= 0 && index < obj.length) {
+          if (this.matchesArtifactId(obj[index], artifactId)) {
+            obj.splice(index, 1);
+          }
+        } else {
+          for (const item of obj) {
+            this.removePathFromObject(item, tokens, artifactId);
+          }
+        }
+        return;
+      }
+
+      if (lastToken in obj) {
+        const val: any = obj[lastToken];
+        if (val === artifactId) {
+          delete obj[lastToken];
+        } else if (Array.isArray(val)) {
+          for (let i = val.length - 1; i >= 0; i--) {
+            if (this.matchesArtifactId(val[i], artifactId)) {
+              val.splice(i, 1);
+            }
+          }
+        } else if (val && typeof val === 'object') {
+          if (this.matchesArtifactId(val, artifactId)) {
+            delete obj[lastToken];
+          }
+        }
+      }
+      return;
+    }
+
+    const currentToken: string = tokens[0];
+    const remainingTokens: string[] = tokens.slice(1);
+
+    if (currentToken === '*' || currentToken === '[]') {
+      if (Array.isArray(obj)) {
+        for (const item of obj) {
+          this.removePathFromObject(item, remainingTokens, artifactId);
+        }
+      }
+      return;
+    }
+
+    if (Array.isArray(obj)) {
+      const index: number = parseInt(currentToken, 10);
+      if (!isNaN(index) && index >= 0 && index < obj.length) {
+        this.removePathFromObject(obj[index], remainingTokens, artifactId);
+      } else {
+        for (const item of obj) {
+          this.removePathFromObject(item, tokens, artifactId);
+        }
+      }
+      return;
+    }
+
+    if (currentToken in obj) {
+      const nextObj: any = obj[currentToken];
+      if (Array.isArray(nextObj)) {
+        const nextToken: string = remainingTokens[0];
+        if (nextToken === '*' || nextToken === '[]' || !isNaN(parseInt(nextToken, 10))) {
+          this.removePathFromObject(nextObj, remainingTokens, artifactId);
+        } else {
+          for (const item of nextObj) {
+            this.removePathFromObject(item, remainingTokens, artifactId);
+          }
+        }
+      } else if (nextObj && typeof nextObj === 'object') {
+        this.removePathFromObject(nextObj, remainingTokens, artifactId);
+      }
+    }
+  }
