+import { auto, mock } from 'angular';
+
+import { IPipeline, IStage } from 'core/domain';
+import {
+  ARTIFACT_REFERENCE_SERVICE_PROVIDER,
+  ArtifactReferenceServiceProvider
+} from './artifactReferenceServiceProvider';
+
+describe('ArtifactReferenceServiceProvider', () => {
+  let provider: ArtifactReferenceServiceProvider;
+  let service: ArtifactReferenceServiceProvider;
+
+  beforeEach(() => {
+    mock.module(
+      ARTIFACT_REFERENCE_SERVICE_PROVIDER,
+      (artifactReferenceServiceProvider: ArtifactReferenceServiceProvider) => {
+        provider = artifactReferenceServiceProvider;
+      }
+    );
+
+    mock.inject(($injector: auto.IInjectorService) => {
+      service = provider.$get($injector);
+    });
+  });
+
+  describe('registration', () => {
+    it('registers single reference path for a stage type', () => {
+      provider.registerReferencePath('deployManifest', 'manifestArtifactId');
+      expect(service.getRegisteredReferencePaths('deployManifest')).toEqual(['manifestArtifactId']);
+    });
+
+    it('registers multiple reference paths for a stage type', () => {
+      provider.registerReferencePaths('deployManifest', ['manifestArtifactId', 'requiredArtifactIds']);
+      expect(service.getRegisteredReferencePaths('deployManifest')).toEqual([
+        'manifestArtifactId',
+        'requiredArtifactIds'
+      ]);
+    });
+
+    it('accumulates multiple registrations for the same stage type', () => {
+      provider.registerReferencePath('customStage', 'fieldA');
+      provider.registerReferencePath('customStage', 'fieldB');
+      provider.registerReferencePaths('customStage', ['fieldC', 'fieldD']);
+      expect(service.getRegisteredReferencePaths('customStage')).toEqual([
+        'fieldA',
+        'fieldB',
+        'fieldC',
+        'fieldD'
+      ]);
+    });
+
+    it('handles register with string and array', () => {
+      provider.register('stageA', 'pathA');
+      provider.register('stageB', ['pathB1', 'pathB2']);
+      expect(service.getRegisteredReferencePaths('stageA')).toEqual(['pathA']);
+      expect(service.getRegisteredReferencePaths('stageB')).toEqual(['pathB1', 'pathB2']);
+    });
+
+    it('returns empty array for unregistered stage type', () => {
+      expect(service.getRegisteredReferencePaths('unknownStage')).toEqual([]);
+    });
+
+    it('includes wildcard paths for all stage types', () => {
+      provider.registerReferencePath('*', 'commonArtifactId');
+      provider.registerReferencePath('deployManifest', 'manifestArtifactId');
+
+      expect(service.getRegisteredReferencePaths('deployManifest')).toEqual([
+        'manifestArtifactId',
+        'commonArtifactId'
+      ]);
+      expect(service.getRegisteredReferencePaths('otherStage')).toEqual(['commonArtifactId']);
+    });
+
+    it('checks hasReferencePaths correctly', () => {
+      expect(service.hasReferencePaths('stageA')).toBe(false);
+      provider.registerReferencePath('stageA', 'fieldA');
+      expect(service.hasReferencePaths('stageA')).toBe(true);
+    });
+  });
+
+  describe('artifact removal sweep', () => {
+    beforeEach(() => {
+      provider.registerReferencePaths('deployManifest', [
+        'manifestArtifactId',
+        'requiredArtifactIds'
+      ]);
+      provider.registerReferencePaths('customStage', [
+        'nested.expectedArtifactId',
+        'artifacts[0]',
+        'containers[0].artifactId',
+        'containers.imageDescription.artifactId'
+      ]);
+    });
+
+    it('removes top-level matching property and leaves other properties untouched', () => {
+      const stage: IStage = {
+        type: 'deployManifest',
+        name: 'Deploy',
+        manifestArtifactId: 'art-123',
+        cloudProvider: 'kubernetes'
+      } as any;
+
+      service.removeArtifactFromStage('art-123', stage);
+
+      expect((stage as any).manifestArtifactId).toBeUndefined();
+      expect(stage.name).toBe('Deploy');
+      expect(stage.cloudProvider).toBe('kubernetes');
+    });
+
+    it('leaves top-level property untouched if artifact ID does not match', () => {
+      const stage: IStage = {
+        type: 'deployManifest',
+        name: 'Deploy',
+        manifestArtifactId: 'art-456'
+      } as any;
+
+      service.removeArtifactFromStage('art-123', stage);
+
+      expect((stage as any).manifestArtifactId).toBe('art-456');
+    });
+
+    it('removes deeply nested matching property', () => {
+      const stage: IStage = {
+        type: 'customStage',
+        name: 'Custom',
+        nested: {
+          expectedArtifactId: 'art-123',
+          otherConfig: 'keepMe'
+        }
+      } as any;
+
+      service.removeArtifactFromStage('art-123', stage);
+
+      expect((stage as any).nested.expectedArtifactId).toBeUndefined();
+      expect((stage as any).nested.otherConfig).toBe('keepMe');
+    });
+
+    it('leaves stage unchanged if nested path cannot be fully resolved', () => {
+      const stage: IStage = {
+        type: 'customStage',
+        name: 'Custom'
+      } as any;
+
+      service.removeArtifactFromStage('art-123', stage);
+
+      expect((stage as any).nested).toBeUndefined();
+      expect(stage.name).toBe('Custom');
+    });
+
