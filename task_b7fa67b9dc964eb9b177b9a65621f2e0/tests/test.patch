+// The dissipated power is lengthDot * (Tterm - T0) and never negative.
+template <typename C = CableSpan>
+void testFrictionPowerBalance() {
+    if constexpr (!has_calcFrictionPowerDissipation<C>::value ||
+                  !has_calcTensionAtTermination<C>::value ||
+                  !has_setObstacleFrictionCoefficient<C>::value) {
+        CABLE_CHECK(false, "CableSpan::calcFrictionPowerDissipation not implemented");
+    } else {
+        TwoObstacleMovingFixture<C> fix;
+
+        const Real mu0 = 0.25;
+        const Real mu1 = 0.40;
+        fix.cable.setObstacleFrictionCoefficient(Obs0, mu0);
+        fix.cable.setObstacleFrictionCoefficient(Obs1, mu1);
+
+        const Real T0 = 13.0;
+
+        // Lengthening and shortening.
+        for (const Real sign : {1., -1.}) {
+            State s = fix.makeState(sign * 2.0);
+
+            Real P = fix.cable.calcFrictionPowerDissipation(s, T0);
+            CABLE_CHECK(P >= 0.0, "Friction dissipation must be non-negative (got %f)", P);
+
+            Real Tterm = fix.cable.calcTensionAtTermination(s, T0);
+            Real lengthDot = fix.cable.calcLengthDot(s);
+            Real P_expected = lengthDot * (Tterm - T0);
+            std::cout << "lengthDot " << lengthDot << ": Tterm " << Tterm << " P " << P << std::endl;
+
+            CABLE_CHECK(std::abs(P - P_expected) < 1e-10,
+                "Power balance error: got %f, expected %f (diff %e)", P, P_expected, std::abs(P - P_expected));
+
+            // Against the wrap angles known from the geometry.
+            Real geometricTterm = T0 * std::exp(sign * (mu0 + mu1) * fix.wrapAnglePerSphere());
+            Real P_geometric = lengthDot * (geometricTterm - T0);
+            CABLE_CHECK(P_geometric > 0.1 && std::abs(P - P_geometric) < 1e-4 * P_geometric,
+                "Dissipated power is %.9f, expected %.9f from the wrap geometry", P, P_geometric);
+        }
+
+        // At rest nothing is dissipated.
+        {
+            State s = fix.makeState(0.);
+            Real P = fix.cable.calcFrictionPowerDissipation(s, T0);
+            CABLE_CHECK(std::abs(P) < 1e-14, "Power dissipation must be zero at zero speed (got %e)", P);
+        }
+
+        // Without friction nothing is dissipated.
+        {
+            fix.cable.setObstacleFrictionCoefficient(Obs0, 0.0);
+            fix.cable.setObstacleFrictionCoefficient(Obs1, 0.0);
+            State s = fix.makeState(2.0);
+            Real P = fix.cable.calcFrictionPowerDissipation(s, T0);
+            CABLE_CHECK(std::abs(P) < 1e-14, "Power dissipation must be zero when mu=0 (got %e)", P);
+        }
+    }
+}
