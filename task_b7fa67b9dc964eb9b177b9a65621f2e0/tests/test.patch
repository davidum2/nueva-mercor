+// Tension grows by exp(mu*theta) across each wrapped obstacle while the cable lengthens,
+// and decays by the same factor while it shortens.
+template <typename C = CableSpan>
+void checkTensionPropagation(Real termSpeed) {
+    if constexpr (!has_calcTensionAtTermination<C>::value ||
+                  !has_setObstacleFrictionCoefficient<C>::value ||
+                  !has_calcCurveSegmentWrapAngle<C>::value) {
+        CABLE_CHECK(false, "CableSpan::calcTensionAtTermination not implemented");
+    } else {
+        TwoObstacleMovingFixture<C> fix;
+
+        const Real mu0 = 0.20;
+        const Real mu1 = 0.45;
+        fix.cable.setObstacleFrictionCoefficient(Obs0, mu0);
+        fix.cable.setObstacleFrictionCoefficient(Obs1, mu1);
+
+        State s = fix.makeState(termSpeed);
+        const Real sign = termSpeed > 0. ? 1. : -1.;
+
+        Real lengthDot = fix.cable.calcLengthDot(s);
+        CABLE_CHECK(sign * lengthDot > 0.05 * std::abs(termSpeed),
+            "Cable length rate must follow the termination speed (got lengthDot=%e)", lengthDot);
+
+        CABLE_CHECK(fix.cable.isInContactWithObstacle(s, Obs0), "Obstacle 0 must be in contact");
+        CABLE_CHECK(fix.cable.isInContactWithObstacle(s, Obs1), "Obstacle 1 must be in contact");
+
+        Real theta0 = fix.cable.calcCurveSegmentWrapAngle(s, Obs0);
+        Real theta1 = fix.cable.calcCurveSegmentWrapAngle(s, Obs1);
+        const Real thetaExpected = fix.wrapAnglePerSphere();
+        CABLE_CHECK(std::abs(theta0 - thetaExpected) < 1e-5,
+            "Wrap angle on obstacle 0 is %.9f, expected %.9f", theta0, thetaExpected);
+        CABLE_CHECK(std::abs(theta1 - thetaExpected) < 1e-5,
+            "Wrap angle on obstacle 1 is %.9f, expected %.9f", theta1, thetaExpected);
+
+        const Real T0 = 13.0;
+        Real gotTterm = fix.cable.calcTensionAtTermination(s, T0);
+        std::cout << "termSpeed " << termSpeed << ": theta0 " << theta0 << " theta1 " << theta1
+                  << " Tterm " << gotTterm << std::endl;
+
+        // Against the wrap angles known from the geometry.
+        Real geometricTterm = T0 * std::exp(sign * (mu0 + mu1) * thetaExpected);
+        CABLE_CHECK(std::abs(gotTterm - geometricTterm) < 1e-5 * geometricTterm,
+            "Termination tension is %.9f, expected %.9f from the wrap geometry",
+            gotTterm, geometricTterm);
+
+        // Against the reported wrap angles.
+        Real expectedTterm = T0 * std::exp(sign * (mu0 * theta0 + mu1 * theta1));
+        CABLE_CHECK(std::abs(gotTterm - expectedTterm) < 1e-6 * expectedTterm,
+            "Tension propagation error: got %.9f, expected %.9f (ratio error %e)",
+            gotTterm, expectedTterm, std::abs(gotTterm - expectedTterm) / expectedTterm);
+        CABLE_CHECK(sign * (gotTterm - T0) > 0.,
+            "Tension must rise toward the termination when lengthening and fall when shortening");
+    }
+}
