+// calcCurveSegmentWrapAngle returns NaN when the indexed obstacle is not in contact.
+template <typename C = CableSpan>
+void testWrapAngleNoContact() {
+    if constexpr (!has_calcCurveSegmentWrapAngle<C>::value) {
+        CABLE_CHECK(false, "CableSpan::calcCurveSegmentWrapAngle not implemented");
+    } else {
+        MultibodySystem system;
+        SimbodyMatterSubsystem matter(system);
+        CableSubsystem cables(system);
+
+        Body::Rigid aBody(MassProperties(1., Vec3(0), Inertia(1)));
+        // Position origin and termination above the obstacle (positive y)
+        MobilizedBody::Free originBody(matter.Ground(), Vec3(-2., 2.0, 0.), aBody, Transform());
+        MobilizedBody::Free termBody(matter.Ground(), Vec3(2., 2.0, 0.), aBody, Transform());
+
+        C cable(cables, originBody, Vec3(0.), termBody, Vec3(0.));
+        cable.setCurveSegmentAccuracy(1e-12);
+        cable.setSmoothnessTolerance(1e-8);
+
+        // Obstacle at (0, -1, 0) with radius 1, so top is at y = 0
+        cable.addObstacle(
+            matter.Ground(),
+            Transform(Vec3(0., -1.0, 0.)),
+            std::shared_ptr<ContactGeometry>(new ContactGeometry::Sphere(1.0)),
+            Vec3(0., 1.0, 0.));
+
+        system.realizeTopology();
+        State s = system.getDefaultState();
+        system.realize(s, Stage::Position);
+
+        CABLE_CHECK(!cable.isInContactWithObstacle(s, Obs0),
+            "Cable should not be in contact with obstacle");
+
+        Real theta = cable.calcCurveSegmentWrapAngle(s, Obs0);
+        CABLE_CHECK(std::isnan(theta),
+            "calcCurveSegmentWrapAngle must return NaN when obstacle is not in contact");
+    }
+}
+
+// calcCurveSegmentWrapAngle requires the State to be realized through Stage::Position.
+template <typename C = CableSpan>
+void testWrapAngleStageRequirement() {
+    if constexpr (!has_calcCurveSegmentWrapAngle<C>::value) {
+        CABLE_CHECK(false, "CableSpan::calcCurveSegmentWrapAngle not implemented");
+    } else {
+        MultibodySystem system;
+        SimbodyMatterSubsystem matter(system);
+        CableSubsystem cables(system);
+
+        Body::Rigid aBody(MassProperties(1., Vec3(0), Inertia(1)));
+        MobilizedBody::Free originBody(matter.Ground(), Vec3(-2., 0., 0.), aBody, Transform());
+        MobilizedBody::Free termBody(matter.Ground(), Vec3(2., 0., 0.), aBody, Transform());
+
+        C cable(cables, originBody, Vec3(0.), termBody, Vec3(0.));
+        cable.addObstacle(
+            matter.Ground(),
+            Transform(Vec3(0., -0.5, 0.)),
+            std::shared_ptr<ContactGeometry>(new ContactGeometry::Sphere(1.0)),
+            Vec3(0., 0.5, 0.));
+
+        system.realizeTopology();
+        State s = system.getDefaultState();
+
+        // Calling at Stage::Time or lower must throw
+        bool threw = false;
+        try {
+            cable.calcCurveSegmentWrapAngle(s, Obs0);
+        } catch (const std::exception&) {
+            threw = true;
+        }
+        CABLE_CHECK(threw, "calcCurveSegmentWrapAngle must throw when state is not realized to Stage::Position");
+
+        // After realize to Stage::Position, must succeed and return finite non-negative angle
+        system.realize(s, Stage::Position);
+        Real theta = cable.calcCurveSegmentWrapAngle(s, Obs0);
+        CABLE_CHECK(!std::isnan(theta) && theta >= 0.0,
+            "calcCurveSegmentWrapAngle must succeed at Stage::Position and return finite non-negative angle");
+    }
+}
