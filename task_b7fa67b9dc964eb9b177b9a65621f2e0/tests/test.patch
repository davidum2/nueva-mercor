+// A nonpositive origin tension represents slack: termination tension and dissipation are zero and force application is a no-op.
+template <typename C = CableSpan>
+void testSlackCable() {
+    if constexpr (!has_calcTensionAtTermination<C>::value ||
+                  !has_calcFrictionPowerDissipation<C>::value ||
+                  !has_applyBodyForcesWithFriction<C>::value ||
+                  !has_setObstacleFrictionCoefficient<C>::value) {
+        CABLE_CHECK(false, "CableSpan slack APIs not implemented");
+    } else {
+        TwoObstacleMovingFixture<C> fix;
+
+        fix.cable.setObstacleFrictionCoefficient(Obs0, 0.35);
+        fix.cable.setObstacleFrictionCoefficient(Obs1, 0.50);
+
+        State s = fix.makeState(2.0);
+
+        const int numBodies = fix.matter.getNumBodies();
+        Vector_<SpatialVec> sentinels(numBodies);
+        for (int i = 0; i < numBodies; ++i) {
+            sentinels[i] = SpatialVec(Vec3(i * 1.1 + 0.1, i * 2.2 + 0.2, i * 3.3 + 0.3),
+                                      Vec3(i * 4.4 + 0.4, i * 5.5 + 0.5, i * 6.6 + 0.6));
+        }
+
+        for (Real slackTension : {0.0, -3.0}) {
+            Real Tterm = fix.cable.calcTensionAtTermination(s, slackTension);
+            CABLE_CHECK(Tterm == 0.0,
+                "Termination tension for slack tension %f must be 0 (got %f)", slackTension, Tterm);
+
+            Real P = fix.cable.calcFrictionPowerDissipation(s, slackTension);
+            CABLE_CHECK(P == 0.0,
+                "Power dissipation for slack tension %f must be 0 (got %f)", slackTension, P);
+
+            Vector_<SpatialVec> testForces = sentinels;
+            fix.cable.applyBodyForcesWithFriction(s, slackTension, testForces);
+
+            for (int i = 0; i < numBodies; ++i) {
+                CABLE_CHECK(testForces[i][0] == sentinels[i][0] && testForces[i][1] == sentinels[i][1],
+                    "applyBodyForcesWithFriction for slack tension %f must leave body %i forces unchanged", slackTension, i);
+            }
+        }
+    }
