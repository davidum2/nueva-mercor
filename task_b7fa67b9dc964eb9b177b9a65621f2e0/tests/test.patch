+// Report a failed check and stop; active in every build configuration.
+static void failCheck(int line, const char* fmt, ...)
+{
+    char msg[1024];
+    va_list args;
+    va_start(args, fmt);
+    std::vsnprintf(msg, sizeof(msg), fmt, args);
+    va_end(args);
+    std::cout << "FAILED at line " << line << ": " << msg << std::endl;
+    std::exit(1);
+}
+
+#undef CABLE_CHECK
+#define CABLE_CHECK(cond, ...) \
+    ((cond) ? (void)0 : failCheck(__LINE__, __VA_ARGS__))
+
+static const CableSpanObstacleIndex Obs0(0);
+static const CableSpanObstacleIndex Obs1(1);
+static const CableSpanObstacleIndex Obs2(2);
+
+static Real angleBetween(const Vec3& a, const Vec3& b)
+{
+    return std::atan2((a % b).norm(), dot(a, b));
+}
+
+static Vec3 entryTangent(
+    const CableSpan& cable, const State& s, CableSpanObstacleIndex ix)
+{
+    return Vec3(cable.calcCurveSegmentInitialFrenetFrame(s, ix).R().x());
+}
+
+static Vec3 exitTangent(
+    const CableSpan& cable, const State& s, CableSpanObstacleIndex ix)
+{
+    return Vec3(cable.calcCurveSegmentFinalFrenetFrame(s, ix).R().x());
+}
+
+// On a sphere every geodesic is a great circle, so the turning is arc/radius.
+static Real sphereWrapAngle(
+    const CableSpan& cable, const State& s, CableSpanObstacleIndex ix,
+    Real radius)
+{
+    return cable.calcCurveSegmentArcLength(s, ix) / radius;
+}
+
+// Turning of the tangent along a curve segment, from a fine resampling of it.
+static Real estimateTurning(
+    const CableSpan& cable, const State& s, CableSpanObstacleIndex ix)
+{
+    std::vector<Vec3> pts;
+    cable.calcCurveSegmentResampledPoints(s, ix, 200,
+        [&](Vec3 p) { pts.push_back(p); });
+    std::vector<Vec3> dirs;
+    dirs.push_back(entryTangent(cable, s, ix));
+    for (size_t i = 0; i + 1 < pts.size(); ++i) {
+        dirs.push_back(pts[i + 1] - pts[i]);
+    }
+    dirs.push_back(exitTangent(cable, s, ix));
+    Real turning = 0.;
+    for (size_t i = 0; i + 1 < dirs.size(); ++i) {
+        turning += angleBetween(dirs[i], dirs[i + 1]);
+    }
+    return turning;
+}
