+// Checks whether CableSpan provides each of the friction methods.
+template <typename T, typename = void>
+struct has_setObstacleFrictionCoefficient : std::false_type {};
+template <typename T>
+struct has_setObstacleFrictionCoefficient<T, std::void_t<
+    decltype(std::declval<T>().setObstacleFrictionCoefficient(Obs0, Real(0)))
+>> : std::true_type {};
+
+template <typename T, typename = void>
+struct has_getObstacleFrictionCoefficient : std::false_type {};
+template <typename T>
+struct has_getObstacleFrictionCoefficient<T, std::void_t<
+    decltype(std::declval<const T>().getObstacleFrictionCoefficient(Obs0))
+>> : std::true_type {};
+
+template <typename T, typename = void>
+struct has_calcCurveSegmentWrapAngle : std::false_type {};
+template <typename T>
+struct has_calcCurveSegmentWrapAngle<T, std::void_t<
+    decltype(std::declval<const T>().calcCurveSegmentWrapAngle(std::declval<const State&>(), Obs0))
+>> : std::true_type {};
+
+template <typename T, typename = void>
+struct has_calcTensionAtTermination : std::false_type {};
+template <typename T>
+struct has_calcTensionAtTermination<T, std::void_t<
+    decltype(std::declval<const T>().calcTensionAtTermination(std::declval<const State&>(), Real(0)))
+>> : std::true_type {};
+
+template <typename T, typename = void>
+struct has_applyBodyForcesWithFriction : std::false_type {};
+template <typename T>
+struct has_applyBodyForcesWithFriction<T, std::void_t<
+    decltype(std::declval<const T>().applyBodyForcesWithFriction(std::declval<const State&>(), Real(0), std::declval<Vector_<SpatialVec>&>()))
+>> : std::true_type {};
+
+template <typename T, typename = void>
+struct has_calcFrictionPowerDissipation : std::false_type {};
+template <typename T>
+struct has_calcFrictionPowerDissipation<T, std::void_t<
+    decltype(std::declval<const T>().calcFrictionPowerDissipation(std::declval<const State&>(), Real(0)))
+>> : std::true_type {};
