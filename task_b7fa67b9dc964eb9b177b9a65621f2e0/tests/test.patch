+// Only obstacles currently in contact contribute to the propagated tension.
+template <typename C = CableSpan>
+void testLiftedObstacleExcludedFromTension() {
+    if constexpr (!has_calcTensionAtTermination<C>::value ||
+                  !has_setObstacleFrictionCoefficient<C>::value ||
+                  !has_calcCurveSegmentWrapAngle<C>::value) {
+        CABLE_CHECK(false, "CableSpan::calcTensionAtTermination not implemented");
+    } else {
+        MultibodySystem system;
+        SimbodyMatterSubsystem matter(system);
+        CableSubsystem cables(system);
+        MobilizedBody::Free movingTermBody(
+            matter.Ground(),
+            Vec3(5., 0., 0.),
+            Body::Rigid(MassProperties(1., Vec3(0), Inertia(1))),
+            Transform());
+
+        C cable(cables, matter.Ground(), Vec3(-1., 0., 0.), movingTermBody, Vec3(0.));
+        cable.setCurveSegmentAccuracy(1e-12);
+        cable.setSmoothnessTolerance(1e-8);
+
+        // Obstacle 0 reaches up to y = 0.5 and is wrapped.
+        cable.addObstacle(
+            matter.Ground(),
+            Transform(Vec3(1., -0.5, 0.)),
+            std::shared_ptr<ContactGeometry>(new ContactGeometry::Sphere(1.0)),
+            Vec3(0., 0.5, 0.));
+
+        // Obstacle 1 sits far below the cable.
+        cable.addObstacle(
+            matter.Ground(),
+            Transform(Vec3(3., -5.0, 0.)),
+            std::shared_ptr<ContactGeometry>(new ContactGeometry::Sphere(1.0)),
+            Vec3(0., 1.0, 0.));
+
+        auto makeState = [&]() {
+            State s = system.realizeTopology();
+            movingTermBody.setU(s, Vec6{0., 0., 0., 2.0, 0., 0.});
+            system.realize(s, Stage::Velocity);
+            return s;
+        };
+
+        cable.setObstacleFrictionCoefficient(Obs0, 0.20);
+        cable.setObstacleFrictionCoefficient(Obs1, 4.0);
+        State s = makeState();
+
+        CABLE_CHECK(cable.isInContactWithObstacle(s, Obs0), "Obstacle 0 must be in contact");
+        CABLE_CHECK(!cable.isInContactWithObstacle(s, Obs1), "Obstacle 1 must not be in contact");
+
+        Real theta0 = cable.calcCurveSegmentWrapAngle(s, Obs0);
+        const Real thetaExpected =
+            std::asin(1. / std::sqrt(4.25)) - std::atan(0.25) +
+            std::asin(1. / std::sqrt(16.25)) - std::atan(0.125);
+        std::cout << "theta0 " << theta0 << " expected " << thetaExpected
+                  << " arc/R " << sphereWrapAngle(cable, s, Obs0, 1.) << std::endl;
+        CABLE_CHECK(std::abs(theta0 - thetaExpected) < 1e-5,
+            "Wrap angle on obstacle 0 is %.9f, expected %.9f", theta0, thetaExpected);
+
+        const Real T0 = 13.0;
+        Real expectedTterm = T0 * std::exp(0.20 * theta0);
+        Real gotTterm1 = cable.calcTensionAtTermination(s, T0);
+
+        CABLE_CHECK(std::abs(gotTterm1 - expectedTterm) < 1e-6 * expectedTterm,
+            "Lifted obstacle should not contribute: got %f, expected %f", gotTterm1, expectedTterm);
+
+        // The coefficient of the lifted obstacle has no effect at all.
+        cable.setObstacleFrictionCoefficient(Obs1, 9.0);
+        State s2 = makeState();
+        Real gotTterm2 = cable.calcTensionAtTermination(s2, T0);
+        CABLE_CHECK(std::abs(gotTterm2 - gotTterm1) < 1e-12,
+            "Changing lifted obstacle coefficient must not change tension: got %f vs %f", gotTterm2, gotTterm1);
+    }
+}
