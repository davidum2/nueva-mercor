+// With every coefficient zero or unset, applyBodyForcesWithFriction reproduces applyBodyForces exactly.
+template <typename C = CableSpan>
+void testZeroMuForceEquivalence() {
+    if constexpr (!has_applyBodyForcesWithFriction<C>::value ||
+                  !has_setObstacleFrictionCoefficient<C>::value) {
+        CABLE_CHECK(false, "CableSpan::applyBodyForcesWithFriction not implemented");
+    } else {
+        MultibodySystem system;
+        SimbodyMatterSubsystem matter(system);
+        CableSubsystem cables(system);
+
+        Body::Rigid aBody(MassProperties(1., Vec3(0), Inertia(1)));
+        MobilizedBody::Free obsBody(matter.Ground(), Vec3(1., -1.0, 0.), aBody, Transform());
+        MobilizedBody::Free movingTermBody(matter.Ground(), Vec3(4., 1.0, 0.), aBody, Transform());
+
+        C cable(cables, matter.Ground(), Vec3(-2., 1.0, 0.), movingTermBody, Vec3(0.));
+        cable.setCurveSegmentAccuracy(1e-12);
+        cable.setSmoothnessTolerance(1e-8);
+
+        cable.addViaPoint(matter.Ground(), Vec3(-0.5, 1.0, 0.));
+        cable.addObstacle(
+            obsBody,
+            Transform(),
+            std::shared_ptr<ContactGeometry>(new ContactGeometry::Sphere(1.0)),
+            Vec3(0., 1.0, 0.));
+
+        system.realizeTopology();
+        State s = system.getDefaultState();
+
+        Vec6 u{0., 0., 0., 1.5, 0., 0.};
+        movingTermBody.setU(s, u);
+        system.realize(s, Stage::Velocity);
+
+        const int numBodies = matter.getNumBodies();
+        const Real T0 = 13.0;
+
+        // 1. Unset coefficients: equivalence within numerical tolerance
+        Vector_<SpatialVec> forcesUniform(numBodies, SpatialVec(Vec3(0.), Vec3(0.)));
+        Vector_<SpatialVec> forcesFriction(numBodies, SpatialVec(Vec3(0.), Vec3(0.)));
+        cable.applyBodyForces(s, T0, forcesUniform);
+        cable.applyBodyForcesWithFriction(s, T0, forcesFriction);
+
+        for (int i = 0; i < numBodies; ++i) {
+            CABLE_CHECK((forcesUniform[i] - forcesFriction[i]).norm() < 1e-12,
+                "Spatial force/moment for body %i does not match applyBodyForces within tolerance: diff norm %e",
+                i, (forcesUniform[i] - forcesFriction[i]).norm());
+        }
+
+        // 2. Explicit zero coefficient: equivalence within tolerance
+        cable.setObstacleFrictionCoefficient(Obs0, 0.0);
+        State sZero = system.realizeTopology();
+        movingTermBody.setU(sZero, u);
+        system.realize(sZero, Stage::Velocity);
+        Vector_<SpatialVec> forcesFrictionZero(numBodies, SpatialVec(Vec3(0.), Vec3(0.)));
+        cable.applyBodyForcesWithFriction(sZero, T0, forcesFrictionZero);
+
+        for (int i = 0; i < numBodies; ++i) {
+            CABLE_CHECK((forcesUniform[i] - forcesFrictionZero[i]).norm() < 1e-12,
+                "Spatial force/moment for body %i with explicit mu=0 does not match applyBodyForces within tolerance: diff norm %e",
+                i, (forcesUniform[i] - forcesFrictionZero[i]).norm());
+        }
+    }
+}
