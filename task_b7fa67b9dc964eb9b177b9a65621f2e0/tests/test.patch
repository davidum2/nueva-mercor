+// Two unit spheres on Ground under a cable whose termination body can move.
+template <typename C = CableSpan>
+struct TwoObstacleMovingFixture {
+    MultibodySystem system;
+    SimbodyMatterSubsystem matter;
+    CableSubsystem cables;
+    MobilizedBody::Free movingTermBody;
+    C cable;
+
+    TwoObstacleMovingFixture() :
+        matter(system),
+        cables(system),
+        movingTermBody(
+            matter.Ground(),
+            Vec3(5., 0., 0.),
+            Body::Rigid(MassProperties(1., Vec3(0), Inertia(1))),
+            Transform()),
+        cable(cables, matter.Ground(), Vec3(-1., 0., 0.), movingTermBody, Vec3(0.))
+    {
+        cable.setCurveSegmentAccuracy(1e-12);
+        cable.setSmoothnessTolerance(1e-8);
+
+        cable.addObstacle(
+            matter.Ground(),
+            Transform(Vec3(1., -0.5, 0.)),
+            std::shared_ptr<ContactGeometry>(new ContactGeometry::Sphere(1.0)),
+            Vec3(0., 0.5, 0.));
+
+        cable.addObstacle(
+            matter.Ground(),
+            Transform(Vec3(3., -0.5, 0.)),
+            std::shared_ptr<ContactGeometry>(new ContactGeometry::Sphere(1.0)),
+            Vec3(0., 0.5, 0.));
+    }
+
+    // Wrap angle on either sphere: the cable leaves the endpoint along a
+    // tangent line and runs level between the two spheres.
+    static Real wrapAnglePerSphere()
+    {
+        return std::asin(1. / std::sqrt(4.25)) - std::atan(0.25);
+    }
+
+    // Fresh state with the termination body moving along x.
+    State makeState(Real termSpeed) const
+    {
+        State s = system.realizeTopology();
+        movingTermBody.setU(s, Vec6{0., 0., 0., termSpeed, 0., 0.});
+        system.realize(s, Stage::Velocity);
+        return s;
+    }
+};
+
+// Wrap angles of a great-circle wrap follow from the geometry alone.
+template <typename C = CableSpan>
+void testSphereWrapAngle() {
+    if constexpr (!has_calcCurveSegmentWrapAngle<C>::value) {
+        CABLE_CHECK(false, "CableSpan::calcCurveSegmentWrapAngle not implemented");
+    } else {
+        {
+            TwoObstacleMovingFixture<C> fix;
+            State s = fix.makeState(0.);
+            const Real expected = fix.wrapAnglePerSphere();
+            for (CableSpanObstacleIndex ix : {Obs0, Obs1}) {
+                CABLE_CHECK(fix.cable.isInContactWithObstacle(s, ix),
+                    "Obstacle %d must be in contact", int(ix));
+                const Real theta = fix.cable.calcCurveSegmentWrapAngle(s, ix);
+                const Real fromArc = sphereWrapAngle(fix.cable, s, ix, 1.);
+                const Real fromTangents = angleBetween(
+                    entryTangent(fix.cable, s, ix), exitTangent(fix.cable, s, ix));
+                std::cout << "sphere " << int(ix) << ": theta " << theta
+                          << " expected " << expected << " arc/R " << fromArc
+                          << " tangents " << fromTangents << std::endl;
+                CABLE_CHECK(std::abs(theta - expected) < 1e-5,
+                    "Wrap angle on sphere %d is %.9f, expected %.9f", int(ix), theta, expected);
+                CABLE_CHECK(std::abs(theta - fromArc) < 1e-5,
+                    "Wrap angle on sphere %d is %.9f, but arc length / radius is %.9f", int(ix), theta, fromArc);
+                CABLE_CHECK(std::abs(theta - fromTangents) < 1e-5,
+                    "Wrap angle on sphere %d is %.9f, but the tangent turns by %.9f", int(ix), theta, fromTangents);
+            }
+        }
+
+        // A sphere whose radius is not one separates angle from arc length.
+        {
+            MultibodySystem system;
+            SimbodyMatterSubsystem matter(system);
+            CableSubsystem cables(system);
+            Body::Rigid aBody(MassProperties(1., Vec3(0), Inertia(1)));
+            MobilizedBody::Free termBody(matter.Ground(), Vec3(2., 0., 0.), aBody, Transform());
+
+            C cable(cables, matter.Ground(), Vec3(-2., 0., 0.), termBody, Vec3(0.));
+            cable.setCurveSegmentAccuracy(1e-12);
+            cable.setSmoothnessTolerance(1e-8);
+
+            const Real radius = 0.6;
+            cable.addObstacle(
+                matter.Ground(),
+                Transform(Vec3(0., -0.2, 0.)),
+                std::shared_ptr<ContactGeometry>(new ContactGeometry::Sphere(radius)),
+                Vec3(0., radius, 0.));
+
+            State s = system.realizeTopology();
+            system.realize(s, Stage::Position);
+            CABLE_CHECK(cable.isInContactWithObstacle(s, Obs0), "Small sphere must be in contact");
+
+            const Real expected = 2. * (std::asin(radius / std::sqrt(4.04)) - std::atan(0.1));
+            const Real theta = cable.calcCurveSegmentWrapAngle(s, Obs0);
+            const Real fromArc = sphereWrapAngle(cable, s, Obs0, radius);
+            std::cout << "small sphere: theta " << theta << " expected " << expected
+                      << " arc/R " << fromArc << std::endl;
+            CABLE_CHECK(std::abs(theta - expected) < 1e-5,
+                "Wrap angle on the radius %.1f sphere is %.9f, expected %.9f", radius, theta, expected);
+            CABLE_CHECK(std::abs(theta - fromArc) < 1e-5,
+                "Wrap angle on the radius %.1f sphere is %.9f, but arc length / radius is %.9f", radius, theta, fromArc);
+        }
+    }
+}
