+// Via points are frictionless and tension is continuous through them.
+template <typename C = CableSpan>
+void testViaPointTensionContinuity() {
+    if constexpr (!has_calcTensionAtTermination<C>::value) {
+        CABLE_CHECK(false, "CableSpan::calcTensionAtTermination not implemented");
+    } else {
+        MultibodySystem system;
