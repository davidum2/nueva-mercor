+// On a surface without a closed-form geodesic the wrap angle still matches the
+// turning of the path tangent, and drives the tension the same way.
+template <typename C = CableSpan>
+void testEllipsoidWrapAngle() {
+    if constexpr (!has_calcCurveSegmentWrapAngle<C>::value ||
+                  !has_setObstacleFrictionCoefficient<C>::value ||
+                  !has_calcTensionAtTermination<C>::value) {
+        CABLE_CHECK(false, "CableSpan friction APIs not implemented");
+    } else {
+        MultibodySystem system;
+        SimbodyMatterSubsystem matter(system);
+        CableSubsystem cables(system);
+
+        Body::Rigid aBody(MassProperties(1., Vec3(0), Inertia(1)));
+        MobilizedBody::Free originBody(matter.Ground(), Vec3(-2., -0.2, -0.5), aBody, Transform());
+        MobilizedBody::Free movingTermBody(matter.Ground(), Vec3(2., -0.2, 0.5), aBody, Transform());
+
+        C cable(cables, originBody, Vec3(0.), movingTermBody, Vec3(0.));
+        cable.setCurveSegmentAccuracy(1e-12);
+        cable.setSmoothnessTolerance(1e-6);
+
+        cable.addObstacle(
+            matter.Ground(),
+            Transform(Vec3(0., -0.5, 0.)),
+            std::shared_ptr<ContactGeometry>(new ContactGeometry::Ellipsoid({1.0, 0.5, 0.75})),
+            Vec3(0., 0.5, 0.));
+
+        const Real mu = 0.30;
+        cable.setObstacleFrictionCoefficient(Obs0, mu);
+
+        State s = system.realizeTopology();
+        movingTermBody.setU(s, Vec6{0., 0., 0., 1.5, 0., 0.});
+        system.realize(s, Stage::Velocity);
+
+        CABLE_CHECK(cable.isInContactWithObstacle(s, Obs0),
+            "Cable should be in contact with ellipsoid obstacle");
+
+        Real theta = cable.calcCurveSegmentWrapAngle(s, Obs0);
+        Real arcLen = cable.calcCurveSegmentArcLength(s, Obs0);
+
+        CABLE_CHECK(!std::isnan(theta) && theta > 0.05,
+            "Ellipsoid wrap angle must be positive and finite (got %f)", theta);
+        CABLE_CHECK(arcLen > 0.05, "Arc length must be positive (got %f)", arcLen);
+
+        const Real turning = estimateTurning(cable, s, Obs0);
+        std::cout << "ellipsoid: theta " << theta << " turning " << turning
+                  << " arc " << arcLen << std::endl;
+        CABLE_CHECK(std::abs(theta - turning) < 0.01 * theta + 1e-3,
+            "Ellipsoid wrap angle (%.9f) deviates from the turning of the path tangent (%.9f) by %e",
+            theta, turning, std::abs(theta - turning));
+
+        Real lengthDot = cable.calcLengthDot(s);
+        CABLE_CHECK(lengthDot > 0.1, "Cable must be lengthening");
+
+        const Real T0 = 10.0;
+        Real expectedTterm = T0 * std::exp(mu * theta);
+        Real gotTterm = cable.calcTensionAtTermination(s, T0);
+
+        CABLE_CHECK(std::abs(gotTterm - expectedTterm) < 1e-6 * expectedTterm,
+            "Ellipsoid tension propagation mismatch: got %f, expected %f (ratio error %e)",
+            gotTterm, expectedTterm, std::abs(gotTterm - expectedTterm) / expectedTterm);
+    }
+}
