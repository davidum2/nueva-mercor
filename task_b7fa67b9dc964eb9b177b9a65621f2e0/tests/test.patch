+// Geometry of the solved path, for comparing two configurations of a cable.
+struct PathSnapshot {
+    Real length;
+    std::vector<bool> contact;
+    std::vector<Real> arcLength;
+    std::vector<Vec3> points;
+
+    template <typename C>
+    PathSnapshot(const C& cable, const State& s, int numObstacles)
+    {
+        length = cable.calcLength(s);
+        for (CableSpanObstacleIndex ix(0); ix < numObstacles; ++ix) {
+            contact.push_back(cable.isInContactWithObstacle(s, ix));
+            arcLength.push_back(cable.calcCurveSegmentArcLength(s, ix));
+            if (!contact.back()) {
+                continue;
+            }
+            cable.calcCurveSegmentResampledPoints(s, ix, 8,
+                [&](Vec3 pt) { points.push_back(pt); });
+            points.push_back(Vec3(cable.calcCurveSegmentInitialFrenetFrame(s, ix).R().x()));
+            points.push_back(Vec3(cable.calcCurveSegmentFinalFrenetFrame(s, ix).R().x()));
+        }
+    }
+};
+
+// Friction coefficients redistribute tension only; the solved path is the frictionless one.
+template <typename C = CableSpan>
+void testFrictionDoesNotChangePath() {
+    if constexpr (!has_setObstacleFrictionCoefficient<C>::value) {
+        CABLE_CHECK(false, "CableSpan::setObstacleFrictionCoefficient not implemented");
+    } else {
+        const Real tol = 1e-9;
+
+        TwoObstacleMovingFixture<C> fix;
+        State s0 = fix.makeState(0.);
+        const PathSnapshot before(fix.cable, s0, 2);
+        CABLE_CHECK(before.contact[0] && before.contact[1], "Both obstacles must be in contact");
+
+        fix.cable.setObstacleFrictionCoefficient(Obs0, 0.85);
+        fix.cable.setObstacleFrictionCoefficient(Obs1, 1.20);
+
+        State s1 = fix.makeState(0.);
+        const PathSnapshot after(fix.cable, s1, 2);
+
+        CABLE_CHECK(std::abs(before.length - after.length) < tol,
+            "Cable length changed with the friction coefficients: %.12f vs %.12f",
+            before.length, after.length);
+        for (int i = 0; i < 2; ++i) {
+            CABLE_CHECK(before.contact[i] == after.contact[i],
+                "Contact status of obstacle %d changed with the friction coefficients", i);
+            CABLE_CHECK(std::abs(before.arcLength[i] - after.arcLength[i]) < tol,
+                "Arc length on obstacle %d changed with the friction coefficients: %.12f vs %.12f",
+                i, before.arcLength[i], after.arcLength[i]);
+        }
+        CABLE_CHECK(before.points.size() == after.points.size(), "Resampled points count must match");
+        for (size_t i = 0; i < before.points.size(); ++i) {
+            CABLE_CHECK((before.points[i] - after.points[i]).norm() < tol,
+                "Curve segment geometry changed with the friction coefficients (sample %d)", int(i));
+        }
+    }
+}
