+
+        Vec6 u{0., 0., 0., 2.0, 0., 0.};
+        movingTermBody.setU(s, u);
+        system.realize(s, Stage::Velocity);
+
+        CABLE_CHECK(cable.isInContactWithObstacle(s, Obs0), "Obstacle 0 must be in contact");
+        CABLE_CHECK(!cable.isInContactWithObstacle(s, Obs1), "Obstacle 1 must NOT be in contact");
+        CABLE_CHECK(cable.isInContactWithObstacle(s, Obs2), "Obstacle 2 must be in contact");
+
+        Real theta0 = cable.calcCurveSegmentWrapAngle(s, Obs0);
+        Real theta1 = cable.calcCurveSegmentWrapAngle(s, Obs1);
+        Real theta2 = cable.calcCurveSegmentWrapAngle(s, Obs2);
+
+        CABLE_CHECK(std::isnan(theta1), "Lifted obstacle 1 wrap angle must be NaN");
+        CABLE_CHECK(std::abs(theta0 - sphereWrapAngle(cable, s, Obs0, 1.)) < 1e-5,
+            "Wrap angle on obstacle 0 is %.9f, but arc length / radius is %.9f",
+            theta0, sphereWrapAngle(cable, s, Obs0, 1.));
+        CABLE_CHECK(std::abs(theta2 - sphereWrapAngle(cable, s, Obs2, 1.)) < 1e-5,
+            "Wrap angle on obstacle 2 is %.9f, but arc length / radius is %.9f",
+            theta2, sphereWrapAngle(cable, s, Obs2, 1.));
+
+        const Real T0 = 13.0;
+        Real expectedTterm = T0 * std::exp(mu0 * theta0 + mu2 * theta2);
+        Real gotTterm = cable.calcTensionAtTermination(s, T0);
+
+        CABLE_CHECK(std::abs(gotTterm - expectedTterm) < 1e-6 * expectedTterm,
+            "Interleaved liftoff tension mismatch: got %f, expected %f (ratio error %e)",
+            gotTterm, expectedTterm, std::abs(gotTterm - expectedTterm) / expectedTterm);
+
+        const int numBodies = matter.getNumBodies();
+        Vector_<SpatialVec> forces(numBodies, SpatialVec(Vec3(0.), Vec3(0.)));
+        cable.applyBodyForcesWithFriction(s, T0, forces);
+
+        MobilizedBodyIndex obs1Ix = obs1Body.getMobilizedBodyIndex();
+        CABLE_CHECK(forces[obs1Ix].norm() < 1e-12,
+            "Lifted obstacle 1 must receive zero spatial wrench (got norm %e)", forces[obs1Ix].norm());
+
+        // Check via point scaling under local continuous tension: T_via = T0 * exp(mu0 * theta0)
+        MobilizedBodyIndex viaIx = viaBody.getMobilizedBodyIndex();
+        Vector_<SpatialVec> forcesUniform(numBodies, SpatialVec(Vec3(0.), Vec3(0.)));
+        cable.applyBodyForces(s, 1.0, forcesUniform);
+        SpatialVec viaUnitForce = forcesUniform[viaIx];
+        CABLE_CHECK(viaUnitForce[1].norm() > 1e-4,
+            "Via point unit force magnitude must be nonzero (got %e)", viaUnitForce[1].norm());
+
+        Real T_via = T0 * std::exp(mu0 * theta0);
+        SpatialVec expectedViaWrench = viaUnitForce * T_via;
+        CABLE_CHECK((forces[viaIx] - expectedViaWrench).norm() < 1e-5,
+            "Via point spatial wrench mismatch under friction: got norm %e, diff norm %e",
+            forces[viaIx].norm(), (forces[viaIx] - expectedViaWrench).norm());
+        CABLE_CHECK((forces[viaIx] - viaUnitForce * T0).norm() > 1e-4,
+            "Via point wrench must separate from T0 scaling: got norm %e vs T0 norm %e",
+            forces[viaIx].norm(), (viaUnitForce * T0).norm());
+
+        Real T_entry2 = T0 * std::exp(mu0 * theta0);
+        Real T_exit2 = expectedTterm;
+
+        Transform XP2 = cable.calcCurveSegmentInitialFrenetFrame(s, Obs2);
+        Transform XQ2 = cable.calcCurveSegmentFinalFrenetFrame(s, Obs2);
+        Vec3 x_GB2 = obs2Body.getBodyOriginLocation(s);
+
+        Vec3 r_P2 = XP2.p() - x_GB2;
+        Vec3 r_Q2 = XQ2.p() - x_GB2;
+        UnitVec3 t_P2 = XP2.R().x();
+        UnitVec3 t_Q2 = XQ2.R().x();
+
+        SpatialVec expectedWrench2;
+        expectedWrench2[0] = r_Q2 % (T_exit2 * t_Q2) - r_P2 % (T_entry2 * t_P2);
+        expectedWrench2[1] = T_exit2 * t_Q2 - T_entry2 * t_P2;
+
+        MobilizedBodyIndex obs2Ix = obs2Body.getMobilizedBodyIndex();
+        SpatialVec diff2 = forces[obs2Ix] - expectedWrench2;
+        CABLE_CHECK(diff2.norm() < 1e-5,
+            "Obstacle 2 spatial wrench error (%e) exceeds tolerance", diff2.norm());
+    }
+}
+
+// Reciprocal tension ratio symmetry and positive dissipation across direction reversal.
+template <typename C = CableSpan>
+void testReversibilitySymmetry() {
+    if constexpr (!has_calcTensionAtTermination<C>::value ||
+                  !has_calcFrictionPowerDissipation<C>::value ||
+                  !has_setObstacleFrictionCoefficient<C>::value) {
+        CABLE_CHECK(false, "CableSpan friction APIs not implemented");
+    } else {
+        MultibodySystem system;
+        SimbodyMatterSubsystem matter(system);
+        CableSubsystem cables(system);
+
+        Body::Rigid aBody(MassProperties(1., Vec3(0), Inertia(1)));
+        MobilizedBody::Free movingTermBody(matter.Ground(), Vec3(5., 0., 0.), aBody, Transform());
+
+        C cable(cables, matter.Ground(), Vec3(-1., 0., 0.), movingTermBody, Vec3(0.));
+        cable.setCurveSegmentAccuracy(1e-12);
+        cable.setSmoothnessTolerance(1e-8);
+
+        cable.addObstacle(matter.Ground(), Transform(Vec3(1., -0.5, 0.)),
+            std::shared_ptr<ContactGeometry>(new ContactGeometry::Sphere(1.0)), Vec3(0., 0.5, 0.));
+        cable.addObstacle(matter.Ground(), Transform(Vec3(3., -0.5, 0.)),
+            std::shared_ptr<ContactGeometry>(new ContactGeometry::Sphere(1.0)), Vec3(0., 0.5, 0.));
+
+        cable.setObstacleFrictionCoefficient(Obs0, 0.28);
+        cable.setObstacleFrictionCoefficient(Obs1, 0.42);
+
+        system.realizeTopology();
+        State s = system.getDefaultState();
+
+        const Real T0 = 17.5;
+
+        // Lengthening state
+        Vec6 u_plus{0., 0., 0., 2.5, 0., 0.};
+        movingTermBody.setU(s, u_plus);
+        system.realize(s, Stage::Velocity);
+
+        Real ldot_plus = cable.calcLengthDot(s);
+        Real T_plus = cable.calcTensionAtTermination(s, T0);
+        Real P_plus = cable.calcFrictionPowerDissipation(s, T0);
+        Real R_plus = T_plus / T0;
+
+        // Shortening state (exact negated velocity)
+        Vec6 u_minus{0., 0., 0., -2.5, 0., 0.};
+        movingTermBody.setU(s, u_minus);
+        system.realize(s, Stage::Velocity);
+
+        Real ldot_minus = cable.calcLengthDot(s);
+        Real T_minus = cable.calcTensionAtTermination(s, T0);
+        Real P_minus = cable.calcFrictionPowerDissipation(s, T0);
+        Real R_minus = T_minus / T0;
+
+        CABLE_CHECK(ldot_plus > 0.1, "Lengthening lengthDot must be positive (got %f)", ldot_plus);
+        CABLE_CHECK(ldot_minus < -0.1, "Shortening lengthDot must be negative (got %f)", ldot_minus);
+
+        // Reciprocal ratio symmetry: R_plus * R_minus == 1
+        CABLE_CHECK(std::abs(R_plus * R_minus - 1.0) < 1e-12,
+            "Capstan ratio product (%f) does not equal 1.0 (diff %e)",
+            R_plus * R_minus, std::abs(R_plus * R_minus - 1.0));
+
+        // Both dissipated powers must be strictly positive
+        CABLE_CHECK(P_plus > 0.0, "Lengthening friction power must be positive (got %f)", P_plus);
+        CABLE_CHECK(P_minus > 0.0, "Shortening friction power must be positive (got %f)", P_minus);
+    }
+}
+
+int main(int argc, char** argv) {
+    std::string testToRun = "";
+    if (argc > 1) {
+        testToRun = argv[1];
+    }
+
+    struct TestCase {
+        std::string name;
+        std::function<void()> func;
+    };
+
+    std::vector<TestCase> tests = {
+        {"coefficient", testCoefficient<>},
+        {"invalid_coefficient", testInvalidCoefficient<>},
+        {"wrap_angle_helix", testHelicalCylinderWrapAngle<>},
+        {"wrap_angle_sphere", testSphereWrapAngle<>},
+        {"wrap_angle_torus", testTorusWrapAngle<>},
+        {"wrap_angle_concave", testConcaveWrapAngle<>},
+        {"wrap_angle_no_contact", testWrapAngleNoContact<>},
+        {"wrap_angle_stage", testWrapAngleStageRequirement<>},
+        {"tension_lengthening", testLengtheningTensionPropagation<>},
+        {"tension_shortening", testShorteningTensionPropagation<>},
+        {"tension_zero_rate", testZeroRateUniformTension<>},
+        {"path_invariance", testFrictionDoesNotChangePath<>},
+        {"liftoff_tension", testLiftedObstacleExcludedFromTension<>},
+        {"via_continuity", testViaPointTensionContinuity<>},
+        {"local_wrenches", testLocalTensionWrenches<>},
+        {"local_wrenches_shortening", testLocalTensionWrenchesShortening<>},
+        {"local_wrenches_zero_rate", testLocalTensionWrenchesZeroRate<>},
+        {"zero_mu_force_equivalence", testZeroMuForceEquivalence<>},
+        {"power_balance", testFrictionPowerBalance<>},
+        {"slack", testSlackCable<>},
+        {"velocity_stage", testVelocityStageRequirements<>},
+        {"wrap_angle_ellipsoid", testEllipsoidWrapAngle<>},
+        {"force_accumulation", testForceAccumulationSuperposition<>},
+        {"interleaved_liftoff_propagation", testInterleavedLiftoffPropagation<>},
+        {"reversibility_symmetry", testReversibilitySymmetry<>}
+    };
+
+    std::cout << std::setprecision(15);
+    bool found = false;
+    try {
+        for (const auto& tc : tests) {
+            if (!testToRun.empty() && tc.name != testToRun) {
+                continue;
+            }
+            found = true;
+            std::cout << "Running test: " << tc.name << std::endl;
+            tc.func();
+            std::cout << "PASSED: " << tc.name << std::endl;
+        }
+    } catch (const std::exception& e) {
+        std::cout << "FAILED with exception: " << e.what() << std::endl;
+        return 1;
+    }
+    if (!found) {
+        std::cout << "Unknown test: " << testToRun << std::endl;
+        return 1;
+    }
+    return 0;
+}
