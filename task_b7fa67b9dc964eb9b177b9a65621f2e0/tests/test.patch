+// Obstacle friction coefficients default to zero and may be set and read independently.
+template <typename C = CableSpan>
+void testCoefficient() {
+    if constexpr (!has_setObstacleFrictionCoefficient<C>::value ||
+                  !has_getObstacleFrictionCoefficient<C>::value) {
+        CABLE_CHECK(false, "CableSpan::setObstacleFrictionCoefficient / getObstacleFrictionCoefficient not implemented");
+    } else {
+        MultibodySystem system;
+        SimbodyMatterSubsystem matter(system);
+        CableSubsystem cables(system);
+        Body::Rigid aBody(MassProperties(1., Vec3(0), Inertia(1)));
+        MobilizedBody::Free body1(matter.Ground(), Vec3(0.), aBody, Transform());
+        MobilizedBody::Free body2(matter.Ground(), Vec3(4., 0., 0.), aBody, Transform());
+
+        C cable(cables, body1, Vec3(0.), body2, Vec3(0.));
+        cable.addObstacle(matter.Ground(), Transform(Vec3(1., 0.5, 0.)),
+            std::shared_ptr<ContactGeometry>(new ContactGeometry::Sphere(1.)), Vec3(1., 0.5, 0.));
+        cable.addObstacle(matter.Ground(), Transform(Vec3(3., 0.5, 0.)),
+            std::shared_ptr<ContactGeometry>(new ContactGeometry::Sphere(1.)), Vec3(3., 0.5, 0.));
+
+        // 1. Default to 0
+        CABLE_CHECK(cable.getObstacleFrictionCoefficient(Obs0) == 0.,
+            "Default friction coefficient for obstacle 0 must be 0");
+        CABLE_CHECK(cable.getObstacleFrictionCoefficient(Obs1) == 0.,
+            "Default friction coefficient for obstacle 1 must be 0");
+
+        // 2. Set and get independently
+        cable.setObstacleFrictionCoefficient(Obs0, 0.25);
+        cable.setObstacleFrictionCoefficient(Obs1, 0.70);
+
+        CABLE_CHECK(std::abs(cable.getObstacleFrictionCoefficient(Obs0) - 0.25) < 1e-12,
+            "Obstacle 0 friction coefficient should be 0.25");
+        CABLE_CHECK(std::abs(cable.getObstacleFrictionCoefficient(Obs1) - 0.70) < 1e-12,
+            "Obstacle 1 friction coefficient should be 0.70");
+
+        // 3. Update obstacle 0 and confirm obstacle 1 is unaffected
+        cable.setObstacleFrictionCoefficient(Obs0, 0.35);
+        CABLE_CHECK(std::abs(cable.getObstacleFrictionCoefficient(Obs0) - 0.35) < 1e-12,
+            "Obstacle 0 friction coefficient should be 0.35");
+        CABLE_CHECK(std::abs(cable.getObstacleFrictionCoefficient(Obs1) - 0.70) < 1e-12,
+            "Obstacle 1 friction coefficient should remain 0.70");
+    }
+}
