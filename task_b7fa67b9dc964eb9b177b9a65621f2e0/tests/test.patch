+// calcTensionAtTermination, applyBodyForcesWithFriction, and calcFrictionPowerDissipation require Stage::Velocity.
+template <typename C = CableSpan>
+void testVelocityStageRequirements() {
+    if constexpr (!has_calcTensionAtTermination<C>::value ||
+                  !has_applyBodyForcesWithFriction<C>::value ||
+                  !has_calcFrictionPowerDissipation<C>::value) {
+        CABLE_CHECK(false, "CableSpan velocity-stage APIs not implemented");
+    } else {
+        TwoObstacleMovingFixture<C> fix;
+        State s = fix.system.realizeTopology();
+
+        // Realize only to Stage::Position
+        fix.system.realize(s, Stage::Position);
+
+        const Real T0 = 13.0;
+        const int numBodies = fix.matter.getNumBodies();
+        Vector_<SpatialVec> forces(numBodies, SpatialVec(Vec3(0.), Vec3(0.)));
+
+        // 1. calcTensionAtTermination throws at Stage::Position
+        bool threwTension = false;
+        try {
+            fix.cable.calcTensionAtTermination(s, T0);
+        } catch (const std::exception&) {
+            threwTension = true;
+        }
+        CABLE_CHECK(threwTension, "calcTensionAtTermination must throw when state is only at Stage::Position");
+
+        // 2. applyBodyForcesWithFriction throws at Stage::Position
+        bool threwForces = false;
+        try {
+            fix.cable.applyBodyForcesWithFriction(s, T0, forces);
+        } catch (const std::exception&) {
+            threwForces = true;
+        }
+        CABLE_CHECK(threwForces, "applyBodyForcesWithFriction must throw when state is only at Stage::Position");
+
+        // 3. calcFrictionPowerDissipation throws at Stage::Position
+        bool threwPower = false;
+        try {
+            fix.cable.calcFrictionPowerDissipation(s, T0);
+        } catch (const std::exception&) {
+            threwPower = true;
+        }
+        CABLE_CHECK(threwPower, "calcFrictionPowerDissipation must throw when state is only at Stage::Position");
+
+        // After realize to Stage::Velocity, all three succeed
+        fix.system.realize(s, Stage::Velocity);
+
+        Real Tterm = fix.cable.calcTensionAtTermination(s, T0);
+        CABLE_CHECK(!std::isnan(Tterm) && Tterm > 0.0, "calcTensionAtTermination must succeed at Stage::Velocity");
+
+        fix.cable.applyBodyForcesWithFriction(s, T0, forces);
+        CABLE_CHECK(forces[fix.movingTermBody.getMobilizedBodyIndex()][1].norm() > 0.0,
+            "applyBodyForcesWithFriction must succeed and accumulate forces at Stage::Velocity");
+
+        Real P = fix.cable.calcFrictionPowerDissipation(s, T0);
+        CABLE_CHECK(!std::isnan(P) && P >= 0.0, "calcFrictionPowerDissipation must succeed at Stage::Velocity");
+    }
+}
