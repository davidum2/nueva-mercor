+// The wrap angle is the integral of the normal curvature along the geodesic,
+// which on a helix differs from the angle between the end tangents.
+template <typename C = CableSpan>
+void testHelicalCylinderWrapAngle() {
+    if constexpr (!has_calcCurveSegmentWrapAngle<C>::value) {
+        CABLE_CHECK(false, "CableSpan::calcCurveSegmentWrapAngle not implemented");
+    } else {
+        for (const Real radius : {1.0, 0.75}) {
+            MultibodySystem system;
+            SimbodyMatterSubsystem matter(system);
+            CableSubsystem cables(system);
+
+            Body::Rigid aBody(MassProperties(1., Vec3(0), Inertia(1)));
+            MobilizedBody::Free originBody(matter.Ground(), Vec3(-2., 1.5, -2.), aBody, Transform());
+            MobilizedBody::Free termBody(matter.Ground(), Vec3(1.5, -2., 2.), aBody, Transform());
+
+            C cable(cables, originBody, Vec3(0.), termBody, Vec3(0.));
+            cable.setCurveSegmentAccuracy(1e-12);
+            cable.setSmoothnessTolerance(1e-8);
+
+            cable.addObstacle(
+                matter.Ground(),
+                Transform(),
+                std::shared_ptr<ContactGeometry>(new ContactGeometry::Cylinder(radius)),
+                Vec3(0.707 * radius, 0.707 * radius, 0.));
+
+            State s = system.realizeTopology();
+            system.realize(s, Stage::Position);
+
+            CABLE_CHECK(cable.isInContactWithObstacle(s, Obs0),
+                "Cable should be in contact with cylinder obstacle");
+
+            Real arcLen = cable.calcCurveSegmentArcLength(s, Obs0);
+            Vec3 pP = cable.calcCurveSegmentInitialFrenetFrame(s, Obs0).p();
+            Vec3 pQ = cable.calcCurveSegmentFinalFrenetFrame(s, Obs0).p();
+
+            Real phiP = std::atan2(pP[1], pP[0]);
+            Real phiQ = std::atan2(pQ[1], pQ[0]);
+            Real dphi = std::abs(phiQ - phiP);
+
+            // For a helix on a cylinder of radius R the normal curvature is
+            // R*dphi^2/L^2, so the wrap angle is R*dphi^2/L.
+            Real thetaExpected = radius * dphi * dphi / arcLen;
+            Real thetaGot = cable.calcCurveSegmentWrapAngle(s, Obs0);
+            std::cout << "helix radius " << radius << ": theta " << thetaGot
+                      << " expected " << thetaExpected
+                      << " turning " << estimateTurning(cable, s, Obs0) << std::endl;
+
+            CABLE_CHECK(std::abs(thetaGot - thetaExpected) < 1e-4,
+                "Wrap angle (%.9f) does not match the normal curvature integral R*dphi^2/L (%.9f) for radius %f",
+                thetaGot, thetaExpected, radius);
+
+            Real endTangentAngle =
+                angleBetween(entryTangent(cable, s, Obs0), exitTangent(cable, s, Obs0));
+            CABLE_CHECK(std::abs(thetaGot - endTangentAngle) > 5e-3,
+                "Wrap angle (%f) must differ from the angle between the end tangents (%f)",
+                thetaGot, endTangentAngle);
+        }
+    }
+}
