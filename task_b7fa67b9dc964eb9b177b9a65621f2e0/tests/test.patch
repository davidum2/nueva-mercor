+// A cable passing through the hole of a torus touches the inner rim, where the
+// surface is concave along the path, so the wrap angle is negative.
+template <typename C = CableSpan>
+void testConcaveWrapAngle() {
+    if constexpr (!has_calcCurveSegmentWrapAngle<C>::value ||
+                  !has_setObstacleFrictionCoefficient<C>::value ||
+                  !has_calcTensionAtTermination<C>::value ||
+                  !has_applyBodyForcesWithFriction<C>::value) {
+        CABLE_CHECK(false, "CableSpan friction APIs not implemented");
+    } else {
+        MultibodySystem system;
+        SimbodyMatterSubsystem matter(system);
+        CableSubsystem cables(system);
+
+        Body::Rigid aBody(MassProperties(1., Vec3(0), Inertia(1)));
+        MobilizedBody::Free termBody(matter.Ground(), Vec3(-3.5, -0.1, -2.3), aBody, Transform());
+
+        C cable(cables, matter.Ground(), Vec3(3.5, -0.1, 2.3), termBody, Vec3(0.));
+        cable.setCurveSegmentAccuracy(1e-12);
+        cable.setSmoothnessTolerance(1e-8);
+        cable.setSolverMaxIterations(100);
+
+        const Real torusRadius = 2.;
+        const Real tubeRadius = 1.;
+        cable.addObstacle(
+            matter.Ground(),
+            Transform(),
+            std::shared_ptr<ContactGeometry>(new ContactGeometry::Torus(torusRadius, tubeRadius)),
+            Vec3(0., torusRadius - tubeRadius, 0.));
+
+        const Real mu = 0.5;
+        cable.setObstacleFrictionCoefficient(Obs0, mu);
+
+        State s = system.realizeTopology();
+        system.realize(s, Stage::Position);
+
+        CABLE_CHECK(cable.isInContactWithObstacle(s, Obs0),
+            "Cable should be in contact with the inner rim of the torus");
+
+        const Real arcLen = cable.calcCurveSegmentArcLength(s, Obs0);
+        const Real thetaExpected =
+            torusNormalCurvatureIntegral(cable, s, Obs0, torusRadius, tubeRadius);
+        const Real theta = cable.calcCurveSegmentWrapAngle(s, Obs0);
+        std::cout << "concave: theta " << theta << " expected " << thetaExpected
+                  << " arc " << arcLen
+                  << " smoothness " << cable.getSmoothness(s) << std::endl;
+
+        CABLE_CHECK(arcLen > 1. && thetaExpected < -0.4,
+            "Contact should run along the concave inner rim (arc %f, curvature integral %f)",
+            arcLen, thetaExpected);
+        CABLE_CHECK(std::abs(theta - thetaExpected) < 1e-3,
+            "Wrap angle on the inner rim of the torus is %.9f, expected the normal curvature integral %.9f",
+            theta, thetaExpected);
+
+        // The capstan factor uses the signed wrap angle: here the tension
+        // falls toward the termination while lengthening and rises while shortening.
+        const Real T0 = 10.0;
+        const Real signs[] = {1., -1.};
+        for (Real sign : signs) {
+            termBody.setU(s, Vec6{0., 0., 0., -1.5 * sign, 0., -1.0 * sign});
+            system.realize(s, Stage::Velocity);
+            const Real lengthDot = cable.calcLengthDot(s);
+            CABLE_CHECK(sign * lengthDot > 0.1,
+                "Unexpected cable length rate %f on the inner rim of the torus", lengthDot);
+
+            const Real expectedTterm = T0 * std::exp(sign * mu * thetaExpected);
+            const Real gotTterm = cable.calcTensionAtTermination(s, T0);
+            std::cout << "concave: lengthDot " << lengthDot << " Tterm " << gotTterm
+                      << " expected " << expectedTterm << std::endl;
+            CABLE_CHECK(std::abs(gotTterm - expectedTterm) < 1e-3 * expectedTterm,
+                "Termination tension with a negative wrap angle is %.9f, expected %.9f",
+                gotTterm, expectedTterm);
+
+            Vector_<SpatialVec> forces(matter.getNumBodies(), SpatialVec(Vec3(0.), Vec3(0.)));
+            cable.applyBodyForcesWithFriction(s, T0, forces);
+            const Real termForce = forces[termBody.getMobilizedBodyIndex()][1].norm();
+            CABLE_CHECK(std::abs(termForce - expectedTterm) < 1e-3 * expectedTterm,
+                "Termination force magnitude with a negative wrap angle is %.9f, expected %.9f",
+                termForce, expectedTterm);
+        }
+    }
+}
