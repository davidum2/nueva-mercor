+
+static Real spatialDiff(const SpatialVec& a, const SpatialVec& b)
+{
+    return std::max((a[0] - b[0]).norm(), (a[1] - b[1]).norm());
+}
+
+// The origin is loaded by the origin tension, the termination by the propagated tension,
+// and the obstacle by its own entry and exit tensions.
+template <typename C = CableSpan>
+void checkLocalWrenches(Real termSpeed) {
+    if constexpr (!has_applyBodyForcesWithFriction<C>::value ||
+                  !has_calcTensionAtTermination<C>::value ||
+                  !has_calcCurveSegmentWrapAngle<C>::value ||
+                  !has_setObstacleFrictionCoefficient<C>::value) {
+        CABLE_CHECK(false, "CableSpan::applyBodyForcesWithFriction not implemented");
+    } else {
+        MultibodySystem system;
+        SimbodyMatterSubsystem matter(system);
+        CableSubsystem cables(system);
+
+        Body::Rigid aBody(MassProperties(1., Vec3(0), Inertia(1)));
+        MobilizedBody::Free originBody(matter.Ground(), Vec3(-2., 0.0, 0.), aBody, Transform());
+        MobilizedBody::Free obstacleBody(matter.Ground(), Vec3(0.4, -0.9, 0.), aBody, Transform());
+        MobilizedBody::Free movingTermBody(matter.Ground(), Vec3(2., 0.0, 0.), aBody, Transform());
+
+        // Attachment stations and the obstacle surface are offset from their body origins.
+        C cable(cables, originBody, Vec3(-0.3, 0.2, 0.), movingTermBody, Vec3(0.3, 0.2, 0.));
+        cable.setCurveSegmentAccuracy(1e-12);
+        cable.setSmoothnessTolerance(1e-8);
+
+        const Real radius = 1.0;
+        cable.addObstacle(
+            obstacleBody,
+            Transform(Vec3(-0.4, 0.4, 0.)),
+            std::shared_ptr<ContactGeometry>(new ContactGeometry::Cylinder(radius)),
+            Vec3(0., 1.0, 0.));
+
+        const Real mu = 0.35;
+        cable.setObstacleFrictionCoefficient(Obs0, mu);
+
+        State s = system.realizeTopology();
+        movingTermBody.setU(s, Vec6{0., 0., 0., termSpeed, 0., 0.});
+        system.realize(s, Stage::Velocity);
+
+        CABLE_CHECK(cable.isInContactWithObstacle(s, Obs0), "Cylinder must be in contact");
+        const Real lengthDot = cable.calcLengthDot(s);
+        const Real sign = termSpeed > 0. ? 1. : (termSpeed < 0. ? -1. : 0.);
+        CABLE_CHECK(sign == 0. ? lengthDot == 0. : sign * lengthDot > 0.05 * std::abs(termSpeed),
+            "Unexpected cable length rate %e for termination speed %e", lengthDot, termSpeed);
+
+        // The cable stays in a plane normal to the cylinder axis, wrapping a
+        // unit circle centred 0.7 below and 2.3 across from either endpoint.
+        const Real thetaExpected = 2. * (std::asin(1. / std::sqrt(5.78)) - std::atan2(0.7, 2.3));
+        const Real theta = cable.calcCurveSegmentWrapAngle(s, Obs0);
+        CABLE_CHECK(std::abs(theta - thetaExpected) < 1e-5,
+            "Wrap angle on the cylinder is %.9f, expected %.9f", theta, thetaExpected);
+
+        const Real T0 = 13.0;
+        const Real TtermExpected = T0 * std::exp(sign * mu * thetaExpected);
+        const Real Tterm = cable.calcTensionAtTermination(s, T0);
+        std::cout << "termSpeed " << termSpeed << ": lengthDot " << lengthDot << " theta " << theta
+                  << " Tterm " << Tterm << " expected " << TtermExpected << std::endl;
+        CABLE_CHECK(std::abs(Tterm - TtermExpected) < 1e-5 * TtermExpected,
+            "Termination tension is %.9f, expected %.9f", Tterm, TtermExpected);
+
+        const int numBodies = matter.getNumBodies();
+        Vector_<SpatialVec> forces(numBodies, SpatialVec(Vec3(0.), Vec3(0.)));
+        cable.applyBodyForcesWithFriction(s, T0, forces);
+
+        // Wrenches of a cable under unit tension.
+        Vector_<SpatialVec> unit(numBodies, SpatialVec(Vec3(0.), Vec3(0.)));
+        cable.applyBodyForces(s, 1.0, unit);
+
+        MobilizedBodyIndex originIx = originBody.getMobilizedBodyIndex();
+        MobilizedBodyIndex obsIx = obstacleBody.getMobilizedBodyIndex();
+        MobilizedBodyIndex termIx = movingTermBody.getMobilizedBodyIndex();
+
+        CABLE_CHECK(spatialDiff(forces[originIx], unit[originIx] * T0) < 1e-6,
+            "Origin wrench must be the unit-tension wrench scaled by the origin tension (error %e)",
+            spatialDiff(forces[originIx], unit[originIx] * T0));
+        CABLE_CHECK(std::abs(forces[originIx][1].norm() - T0) < 1e-6,
+            "Origin force magnitude (%f) does not match T0 (%f)", forces[originIx][1].norm(), T0);
+
+        CABLE_CHECK(spatialDiff(forces[termIx], unit[termIx] * Tterm) < 1e-6,
+            "Termination wrench must be the unit-tension wrench scaled by the termination tension (error %e)",
+            spatialDiff(forces[termIx], unit[termIx] * Tterm));
+        CABLE_CHECK(std::abs(forces[termIx][1].norm() - Tterm) < 1e-6,
+            "Termination force magnitude (%f) does not match Tterm (%f)", forces[termIx][1].norm(), Tterm);
+
+        // Obstacle wrench about the obstacle body origin.
+        Transform XP = cable.calcCurveSegmentInitialFrenetFrame(s, Obs0);
+        Transform XQ = cable.calcCurveSegmentFinalFrenetFrame(s, Obs0);
+        Vec3 x_GB = obstacleBody.getBodyOriginLocation(s);
+
+        Vec3 r_P = XP.p() - x_GB;
+        Vec3 r_Q = XQ.p() - x_GB;
+        Vec3 t_P(XP.R().x());
+        Vec3 t_Q(XQ.R().x());
+
+        const SpatialVec unitExpected(r_Q % t_Q - r_P % t_P, t_Q - t_P);
+        CABLE_CHECK(spatialDiff(unit[obsIx], unitExpected) < 1e-9,
+            "Unit-tension obstacle wrench differs from the contact frame geometry (error %e)",
+            spatialDiff(unit[obsIx], unitExpected));
+
+        const SpatialVec expected(
+            r_Q % (Tterm * t_Q) - r_P % (T0 * t_P),
+            Tterm * t_Q - T0 * t_P);
+        std::cout << "obstacle wrench " << forces[obsIx] << " expected " << expected << std::endl;
+        CABLE_CHECK((forces[obsIx][1] - expected[1]).norm() < 1e-5,
+            "Obstacle force error too large: %e", (forces[obsIx][1] - expected[1]).norm());
+        CABLE_CHECK((forces[obsIx][0] - expected[0]).norm() < 1e-5,
+            "Obstacle moment error too large: %e", (forces[obsIx][0] - expected[0]).norm());
+
+        if (sign == 0.) {
+            // Without sliding the friction-aware forces are the uniform-tension ones.
+            Vector_<SpatialVec> uniform(numBodies, SpatialVec(Vec3(0.), Vec3(0.)));
+            cable.applyBodyForces(s, T0, uniform);
+            for (int i = 0; i < numBodies; ++i) {
+                CABLE_CHECK(spatialDiff(forces[i], uniform[i]) < 1e-9,
+                    "Body %d wrench differs from the uniform-tension wrench at zero length rate (error %e)",
+                    i, spatialDiff(forces[i], uniform[i]));
+            }
+        } else {
+            CABLE_CHECK(sign * (Tterm - T0) > 0.1,
+                "Tension must rise toward the termination when lengthening and fall when shortening");
+        }
+    }
+}
