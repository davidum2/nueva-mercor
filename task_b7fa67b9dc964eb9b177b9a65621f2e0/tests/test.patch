+// Integral of the surface normal curvature along a curve segment on a torus
+// centred at the Ground origin with its axis along z. The principal curvatures
+// are cos(v)/rho around the axis and 1/tubeRadius around the tube.
+static Real torusNormalCurvatureIntegral(
+    const CableSpan& cable, const State& s, CableSpanObstacleIndex ix,
+    Real torusRadius, Real tubeRadius)
+{
+    std::vector<Vec3> pts;
+    cable.calcCurveSegmentResampledPoints(s, ix, 2001,
+        [&](Vec3 p) { pts.push_back(p); });
+    Real integral = 0.;
+    for (size_t i = 0; i + 1 < pts.size(); ++i) {
+        const Vec3 mid = 0.5 * (pts[i] + pts[i + 1]);
+        const Vec3 step = pts[i + 1] - pts[i];
+        const Real rho = std::hypot(mid[0], mid[1]);
+        const Real tube = std::hypot(rho - torusRadius, mid[2]);
+        const Real cosV = (rho - torusRadius) / tube;
+        const Real sinV = mid[2] / tube;
+        const Vec3 aroundAxis(-mid[1] / rho, mid[0] / rho, 0.);
+        const Vec3 aroundTube(-sinV * mid[0] / rho, -sinV * mid[1] / rho, cosV);
+        const Real du = dot(step, aroundAxis);
+        const Real dv = dot(step, aroundTube);
+        const Real ds = std::sqrt(du * du + dv * dv);
+        if (ds > 0.) {
+            integral += (cosV / rho * du * du + dv * dv / tubeRadius) / ds;
+        }
+    }
+    return integral;
+}
