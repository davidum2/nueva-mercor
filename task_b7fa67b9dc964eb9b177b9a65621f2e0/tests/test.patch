+        const Real theta = cable.calcCurveSegmentWrapAngle(s, Obs0);
+        const Real arcLen = cable.calcCurveSegmentArcLength(s, Obs0);
+        std::cout << "torus: theta " << theta << " expected " << thetaExpected
+                  << " arc " << arcLen
+                  << " turning " << estimateTurning(cable, s, Obs0) << std::endl;
+        CABLE_CHECK(std::abs(arcLen - tubeRadius * thetaExpected) < 1e-4,
+            "Arc length on the torus is %.9f, expected %.9f", arcLen, tubeRadius * thetaExpected);
+        CABLE_CHECK(std::abs(theta - thetaExpected) < 1e-4,
