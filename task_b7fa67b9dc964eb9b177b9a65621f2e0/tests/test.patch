+// Setting a negative obstacle friction coefficient throws under the repository's SimTK_ERRCHK convention.
+template <typename C = CableSpan>
+void testInvalidCoefficient() {
+    if constexpr (!has_setObstacleFrictionCoefficient<C>::value ||
+                  !has_getObstacleFrictionCoefficient<C>::value) {
+        CABLE_CHECK(false, "CableSpan::setObstacleFrictionCoefficient not implemented");
+    } else {
+        MultibodySystem system;
+        SimbodyMatterSubsystem matter(system);
+        CableSubsystem cables(system);
+        Body::Rigid aBody(MassProperties(1., Vec3(0), Inertia(1)));
+        MobilizedBody::Free body1(matter.Ground(), Vec3(0.), aBody, Transform());
+        MobilizedBody::Free body2(matter.Ground(), Vec3(2., 0., 0.), aBody, Transform());
+
+        C cable(cables, body1, Vec3(0.), body2, Vec3(0.));
+        cable.addObstacle(matter.Ground(), Transform(Vec3(1., 0.5, 0.)),
+            std::shared_ptr<ContactGeometry>(new ContactGeometry::Sphere(1.)), Vec3(1., 0.5, 0.));
+
+        cable.setObstacleFrictionCoefficient(Obs0, 0.40);
+        CABLE_CHECK(std::abs(cable.getObstacleFrictionCoefficient(Obs0) - 0.40) < 1e-12,
+            "Friction coefficient should be 0.40");
+
+        bool threw = false;
+        try {
+            cable.setObstacleFrictionCoefficient(Obs0, -0.01);
+        } catch (const std::exception&) {
+            threw = true;
+        }
+        CABLE_CHECK(threw, "Negative friction coefficient -0.01 must throw an exception");
+        CABLE_CHECK(std::abs(cable.getObstacleFrictionCoefficient(Obs0) - 0.40) < 1e-12,
+            "Friction coefficient must remain 0.40 after rejected negative value");
+
+        threw = false;
+        try {
+            cable.setObstacleFrictionCoefficient(Obs0, -5.0);
+        } catch (const std::exception&) {
+            threw = true;
+        }
+        CABLE_CHECK(threw, "Negative friction coefficient -5.0 must throw an exception");
+        CABLE_CHECK(std::abs(cable.getObstacleFrictionCoefficient(Obs0) - 0.40) < 1e-12,
+            "Friction coefficient must remain 0.40 after rejected negative value");
+    }
+}
