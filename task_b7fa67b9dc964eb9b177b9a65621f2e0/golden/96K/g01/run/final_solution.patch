+CableSpan::Impl::TensionProfile CableSpan::Impl::calcTensionProfile(
+    const State& state,
+    Real originTension) const
+{
+    realizeVelocity(state);
+
+    TensionProfile profile;
+    profile.obstacleEntryTension.resize(getNumObstacles());
+    profile.obstacleExitTension.resize(getNumObstacles());
+    profile.viaPointTension.resize(getNumViaPoints());
+
+    const Real lengthDot = getDataVel(state).lengthDot;
+    const Real lengthRateSign =
+        lengthDot > 0. ? 1. : (lengthDot < 0. ? -1. : 0.);
+
+    Real tension = originTension;
+    profile.frictionPowerDissipation = 0.;
+
+    for (CableSegmentIndex segmentIx(0);
+         segmentIx < getNumCableSegments();
+         ++segmentIx) {
+        const CableSegment& cableSegment = getCableSegment(segmentIx);
+
+        for (ObstacleIndex obstacleIx :
+             cableSegment.getObstacleIndexes()) {
+            const CurveSegment& curve = getObstacleCurveSegment(obstacleIx);
+            const Real entryTension = tension;
+
+            if (curve.isInContactWithSurface(state)) {
+                const Real wrapAngle = curve.calcWrapAngle(state);
+                const Real frictionCoefficient =
+                    curve.getFrictionCoefficient();
+                const Real exitTension = entryTension *
+                    std::exp(lengthRateSign * frictionCoefficient * wrapAngle);
+
+                profile.frictionPowerDissipation +=
+                    std::abs(lengthDot * (exitTension - entryTension));
+                tension = exitTension;
+                profile.obstacleExitTension[obstacleIx] = exitTension;
+            } else {
+                profile.obstacleExitTension[obstacleIx] = entryTension;
+            }
+
+            profile.obstacleEntryTension[obstacleIx] = entryTension;
+        }
+
+        if (cableSegment.getFinalViaPointIndex().isValid()) {
+            profile.viaPointTension[cableSegment.getFinalViaPointIndex()] =
+                tension;
+        }
+    }
+
+    profile.terminationTension = tension;
+    return profile;
+}
+
+Real CableSpan::Impl::calcTensionAtTermination(
+    const State& state,
+    Real originTension) const
+{
+    realizeVelocity(state);
+
+    if (originTension <= 0.) {
+        return 0.;
+    }
+    return calcTensionProfile(state, originTension).terminationTension;
+}
+
+Real CableSpan::Impl::calcFrictionPowerDissipation(
+    const State& state,
+    Real originTension) const
+{
+    realizeVelocity(state);
+
+    if (originTension <= 0.) {
+        return 0.;
+    }
+    return calcTensionProfile(state, originTension).frictionPowerDissipation;
+}
+
+void CableSpan::Impl::applyBodyForcesWithFriction(
+    const State& state,
+    Real originTension,
+    Vector_<SpatialVec>& bodyForcesInG) const
+{
+    realizeVelocity(state);
+
+    if (originTension <= 0.) {
+        return;
+    }
+
+    const TensionProfile profile =
+        calcTensionProfile(state, originTension);
+
+    // Force applied at cable origin point.
+    {
+        SpatialVec unitForce_G;
+        calcUnitForceAtCableOrigin(*this, state, unitForce_G);
+        getOriginBody().applyBodyForce(
+            state,
+            unitForce_G * originTension,
+            bodyForcesInG);
+    }
+
+    // Forces applied to each obstacle body in contact with the cable. The
+    // entry and exit tensions can differ when there is friction.
+    for (CableSegmentIndex segmentIx(0);
+         segmentIx < getNumCableSegments();
+         ++segmentIx) {
+        const CableSegment& cableSegment = getCableSegment(segmentIx);
+
+        for (ObstacleIndex obstacleIx :
+             cableSegment.getObstacleIndexes()) {
+            const CurveSegment& curve = getObstacleCurveSegment(obstacleIx);
+            if (!curve.isInContactWithSurface(state)) {
+                continue;
+            }
+
+            const CurveSegmentData::Position& dataPos = curve.getDataPos(state);
+            const Vec3& x_GB =
+                curve.getMobilizedBody().getBodyOriginLocation(state);
+            const Vec3 r_P = dataPos.X_GP.p() - x_GB;
+            const Vec3 r_Q = dataPos.X_GQ.p() - x_GB;
+            const UnitVec3& t_P = getTangent(dataPos.X_GP);
+            const UnitVec3& t_Q = getTangent(dataPos.X_GQ);
+
+            const Real entryTension =
+                profile.obstacleEntryTension[obstacleIx];
+            const Real exitTension =
+                profile.obstacleExitTension[obstacleIx];
+            const Vec3 force_P = Vec3(t_P) * entryTension;
+            const Vec3 force_Q = Vec3(t_Q) * exitTension;
+
+            const SpatialVec frictionForce_G(
+                r_Q % force_Q - r_P % force_P,
+                force_Q - force_P);
+            curve.getMobilizedBody().applyBodyForce(
+                state,
+                frictionForce_G,
+                bodyForcesInG);
+        }
+
+        // Forces applied to each via point. Via points are frictionless, so
+        // the incoming and outgoing tensions are continuous.
+        if (cableSegment.getFinalViaPointIndex().isValid()) {
+            const ViaPointIndex viaPointIx =
+                cableSegment.getFinalViaPointIndex();
+            const ViaPoint& viaPoint = getViaPoint(viaPointIx);
+
+            SpatialVec unitForce_G;
+            calcUnitForceExertedByViaPoint(viaPoint, state, unitForce_G);
+            viaPoint.getMobilizedBody().applyBodyForce(
+                state,
+                unitForce_G * profile.viaPointTension[viaPointIx],
+                bodyForcesInG);
+        }
+    }
+
+    // Force applied at cable termination point.
+    {
+        SpatialVec unitForce_G;
+        calcUnitForceAtCableTermination(*this, state, unitForce_G);
+        getTerminationBody().applyBodyForce(
+            state,
+            unitForce_G * profile.terminationTension,
+            bodyForcesInG);
+    }
+}
