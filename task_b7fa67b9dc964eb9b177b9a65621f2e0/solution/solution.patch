+
+            Real wrapAngle = 0.;
+            for (size_t i = 0; i + 1 < knots.size(); ++i) {
+                const Real ds = knots[i+1].arcLength - knots[i].arcLength;
+                const Real k1 = geometry.calcSurfaceCurvatureInDirection(knots[i].point, knots[i].tangent);
+                const Real k2 = geometry.calcSurfaceCurvatureInDirection(knots[i+1].point, knots[i+1].tangent);
+                wrapAngle += 0.5 * (k1 + k2) * ds;
+            }
+            return wrapAngle;
+        }
+
+        const auto& knots = dataInst.geodesicKnotPoints;
+        if (knots.size() < 2) {
+            return 0.;
+        }
+        Real wrapAngle = 0.;
+        for (size_t i = 0; i + 1 < knots.size(); ++i) {
+            const Real ds = knots[i+1].arcLength - knots[i].arcLength;
+            const Real k1 = geometry.calcSurfaceCurvatureInDirection(knots[i].point, knots[i].tangent);
+            const Real k2 = geometry.calcSurfaceCurvatureInDirection(knots[i+1].point, knots[i+1].tangent);
+            wrapAngle += 0.5 * (k1 + k2) * ds;
