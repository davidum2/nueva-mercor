+        // The geometry reports curvature as positive on a convex surface, so
+        // the angle is positive for a cable wrapped over the obstacle (the
+        // path solver's calcSurfaceCurvature helper uses the opposite sign).
+        if (geometry.isAnalyticFormAvailable()) {
+            std::vector<ContactGeometry::GeodesicKnotPoint> knots;
+            const int numSamples = std::max(20, static_cast<int>(dataInst.arcLength / 0.02));
+            geometry.shootGeodesicInDirectionAnalytically(
