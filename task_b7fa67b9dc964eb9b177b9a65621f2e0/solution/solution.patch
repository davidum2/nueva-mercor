+Real CableSpan::Impl::calcTensionAtTermination(const State& state, Real originTension) const
+{
+    SimTK_STAGECHECK_GE_ALWAYS(
+        state.getSystemStage(),
+        Stage::Velocity,
+        "CableSpan::calcTensionAtTermination");
+
+    if (originTension <= 0.) {
+        return 0.;
+    }
+
+    const Real lengthDot = getDataVel(state).lengthDot;
+    if (lengthDot == 0.) {
+        return originTension;
+    }
+
+    Real currentTension = originTension;
+    for (CableSegmentIndex csIx(0); csIx < getNumCableSegments(); ++csIx) {
+        const CableSegment& cableSegment = getCableSegment(csIx);
+        for (ObstacleIndex obsIx : cableSegment.getObstacleIndexes()) {
+            const CurveSegment& curve = getObstacleCurveSegment(obsIx);
+            if (curve.isInContactWithSurface(state)) {
+                const Real mu = curve.getFrictionCoefficient();
+                const Real theta = curve.calcWrapAngle(state);
+                if (lengthDot > 0.) {
+                    currentTension *= std::exp(mu * theta);
+                } else {
+                    currentTension *= std::exp(-mu * theta);
+                }
+            }
+        }
+    }
+    return currentTension;
+}
+
+Real CableSpan::Impl::calcFrictionPowerDissipation(const State& state, Real originTension) const
+{
+    SimTK_STAGECHECK_GE_ALWAYS(
+        state.getSystemStage(),
+        Stage::Velocity,
+        "CableSpan::calcFrictionPowerDissipation");
+
+    if (originTension <= 0.) {
+        return 0.;
+    }
+
+    const Real lengthDot = getDataVel(state).lengthDot;
+    const Real termTension = calcTensionAtTermination(state, originTension);
+    const Real power = lengthDot * (termTension - originTension);
+    return std::max(Real(0.), power);
+}
+
+void CableSpan::Impl::applyBodyForcesWithFriction(
+    const State& s,
+    Real originTension,
+    Vector_<SpatialVec>& bodyForcesInG) const
+{
+    SimTK_STAGECHECK_GE_ALWAYS(
+        s.getSystemStage(),
+        Stage::Velocity,
+        "CableSpan::applyBodyForcesWithFriction");
+
+    if (originTension <= 0.) {
+        return;
+    }
+
+    realizePosition(s);
+    const Real lengthDot = getDataVel(s).lengthDot;
+
+    Real currentTension = originTension;
+    SpatialVec unitForce_G;
+
+    // Force applied at cable origin point
+    {
+        calcUnitForceAtCableOrigin(*this, s, unitForce_G);
+        getOriginBody().applyBodyForce(s, unitForce_G * currentTension, bodyForcesInG);
+    }
+
+    // Walk cable segments
+    for (CableSegmentIndex csIx(0); csIx < getNumCableSegments(); ++csIx) {
+        const CableSegment& cableSegment = getCableSegment(csIx);
+
+        for (ObstacleIndex obsIx : cableSegment.getObstacleIndexes()) {
+            const CurveSegment& curve = getObstacleCurveSegment(obsIx);
+            if (!curve.isInContactWithSurface(s)) {
+                continue;
+            }
+
+            const Real T_entry = currentTension;
+            const Real mu = curve.getFrictionCoefficient();
+            const Real theta = curve.calcWrapAngle(s);
+            Real T_exit = T_entry;
+            if (lengthDot > 0.) {
+                T_exit = T_entry * std::exp(mu * theta);
+            } else if (lengthDot < 0.) {
+                T_exit = T_entry * std::exp(-mu * theta);
+            }
+
+            const CurveSegmentData::Position& dataPos = curve.getDataPos(s);
+            const Vec3& x_GB = curve.getMobilizedBody().getBodyOriginLocation(s);
+
+            const Vec3 r_P = dataPos.X_GP.p() - x_GB;
+            const Vec3 r_Q = dataPos.X_GQ.p() - x_GB;
+            const UnitVec3& t_P = getTangent(dataPos.X_GP);
+            const UnitVec3& t_Q = getTangent(dataPos.X_GQ);
+
+            SpatialVec wrench_G;
+            if (T_exit == T_entry) {
+                wrench_G[0] = (r_Q % t_Q - r_P % t_P) * T_entry;
+                wrench_G[1] = (t_Q - t_P) * T_entry;
+            } else {
+                wrench_G[0] = r_Q % (T_exit * t_Q) - r_P % (T_entry * t_P);
+                wrench_G[1] = T_exit * t_Q - T_entry * t_P;
+            }
+
+            curve.getMobilizedBody().applyBodyForce(s, wrench_G, bodyForcesInG);
+            currentTension = T_exit;
+        }
+
+        if (cableSegment.getFinalViaPointIndex().isValid()) {
+            const ViaPoint& viaPoint = getViaPoint(cableSegment.getFinalViaPointIndex());
+            calcUnitForceExertedByViaPoint(viaPoint, s, unitForce_G);
+            viaPoint.getMobilizedBody().applyBodyForce(s, unitForce_G * currentTension, bodyForcesInG);
+        }
+    }
+
+    // Force applied at cable termination point
+    {
+        calcUnitForceAtCableTermination(*this, s, unitForce_G);
+        getTerminationBody().applyBodyForce(s, unitForce_G * currentTension, bodyForcesInG);
+    }
+}
