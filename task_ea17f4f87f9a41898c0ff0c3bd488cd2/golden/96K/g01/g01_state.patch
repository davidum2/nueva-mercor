+    /**
+     * Returns an anonymous layer with a maximum-weight subset of non-overlapping
+     * annotations in this layer.
+     * @param weightFunction weight of each annotation
+     * @return an anonymous layer with a maximum-weight subset of non-overlapping annotations
+     */
+    public Layer selectMaxWeight(ToDoubleFunction<Annotation> weightFunction) {
+        int size = annotations.size();
+        if (size == 0)
+            return new Layer(section);
+        double[] weights = new double[size];
+        for (int i = 0; i < size; ++i) {
+            double weight = weightFunction.applyAsDouble(annotations.get(i));
+            weights[i] = Double.isNaN(weight) ? 0.0 : weight;
+        }
+        return selectMaxWeight(weights);
+    }
+
+    private Layer selectMaxWeight(double[] weights) {
+        List<WeightedInterval> intervals = new ArrayList<WeightedInterval>();
+        for (int i = 0; i < annotations.size(); ++i) {
+            Annotation annot = annotations.get(i);
+            if (annot.getStart() != annot.getEnd())
+                intervals.add(new WeightedInterval(i, annot.getStart(), annot.getEnd(), weights[i]));
+        }
+
+        Collections.sort(intervals, new Comparator<WeightedInterval>() {
+            @Override
+            public int compare(WeightedInterval left, WeightedInterval right) {
+                return left.end - right.end;
+            }
+        });
+
+        int intervalCount = intervals.size();
+        int[] ends = new int[intervalCount];
+        for (int i = 0; i < intervalCount; ++i)
+            ends[i] = intervals.get(i).end;
+        SelectionState[] states = new SelectionState[intervalCount + 1];
+        states[0] = SelectionState.EMPTY;
+        for (int i = 0; i < intervalCount; ++i) {
+            WeightedInterval interval = intervals.get(i);
+            int predecessor = countEndingAtMost(ends, interval.start);
+            SelectionState without = states[i];
+            SelectionState with = null;
+            SelectionState base = states[predecessor];
+            double total = base.total + interval.weight;
+            if (!Double.isNaN(total))
+                with = new SelectionState(total, new SelectionIndices(base.indices, interval.index));
+            states[i + 1] = best(with, without);
+        }
+
+        SelectionState state = states[intervalCount];
+        boolean[] selected = new boolean[annotations.size()];
+        int maxSelectedIndex = -1;
+        for (SelectionIndices indices = state.indices; indices != null; indices = indices.previous) {
+            selected[indices.index] = true;
+            if (indices.index > maxSelectedIndex)
+                maxSelectedIndex = indices.index;
+        }
+
+        for (int i = annotations.size() - 1; i >= 0; --i) {
+            Annotation annot = annotations.get(i);
+            if (annot.getStart() == annot.getEnd()) {
+                double total = state.total + weights[i];
+                if (!Double.isNaN(total) && ((total > state.total) || ((total == state.total) && (maxSelectedIndex > i)))) {
+                    selected[i] = true;
+                    state = new SelectionState(total, null);
+                    if (i > maxSelectedIndex)
+                        maxSelectedIndex = i;
+                }
+            }
+        }
+
+        List<Annotation> result = new ArrayList<Annotation>();
+        for (int i = 0; i < selected.length; ++i)
+            if (selected[i])
+                result.add(annotations.get(i));
+        return new Layer(section, null, result);
+    }
+
+    private static int countEndingAtMost(int[] ends, int position) {
+        int low = 0;
+        int high = ends.length;
+        while (low < high) {
+            int middle = (low + high) / 2;
+            if (ends[middle] <= position)
+                low = middle + 1;
+            else
+                high = middle;
+        }
+        return low;
+    }
+
+    private static SelectionState best(SelectionState with, SelectionState without) {
+        if (with == null)
+            return without;
+        if (with.total > without.total)
+            return with;
+        if (with.total < without.total)
+            return without;
+        return compareIndices(with.indices, without.indices) < 0 ? with : without;
+    }
+
+    private static int compareIndices(SelectionIndices left, SelectionIndices right) {
+        if (left == right)
+            return 0;
+        int length = Math.min(left.length, right.length);
+        SelectionIndices leftPrefix = dropIndices(left, length);
+        SelectionIndices rightPrefix = dropIndices(right, length);
+        int comparison = compareEqualLengthIndices(leftPrefix, rightPrefix);
+        if (comparison != 0)
+            return comparison;
+        return Integer.compare(left.length, right.length);
+    }
+
+    private static SelectionIndices dropIndices(SelectionIndices indices, int length) {
+        while (indices.length > length)
+            indices = indices.previous;
+        return indices;
+    }
+
+    private static int compareEqualLengthIndices(SelectionIndices left, SelectionIndices right) {
+        if (left == null)
+            return 0;
+        int comparison = compareEqualLengthIndices(left.previous, right.previous);
+        if (comparison != 0)
+            return comparison;
+        return Integer.compare(left.index, right.index);
+    }
+
+    private static final class WeightedInterval {
+        private final int index;
+        private final int start;
+        private final int end;
+        private final double weight;
+
+        private WeightedInterval(int index, int start, int end, double weight) {
+            this.index = index;
+            this.start = start;
+            this.end = end;
+            this.weight = weight;
+        }
+    }
+
+    private static final class SelectionIndices {
+        private final SelectionIndices previous;
+        private final int index;
+        private final int length;
+
+        private SelectionIndices(SelectionIndices previous, int index) {
+            this.previous = previous;
+            this.index = index;
+            this.length = (previous == null ? 0 : previous.length) + 1;
+        }
+    }
+
+    private static final class SelectionState {
+        private static final SelectionState EMPTY = new SelectionState(0.0, null);
+
+        private final double total;
+        private final SelectionIndices indices;
+
+        private SelectionState(double total, SelectionIndices indices) {
+            this.total = total;
+            this.indices = indices;
+        }
+    }
