+final class BestDisjointEvaluator extends AbstractListEvaluator {
+	private static final double DEFAULT_WEIGHT = 1.0;
+
+	private final String layerName;
+	private final Evaluator layerNameEvaluator;
+	private final Evaluator weight;
+
+	BestDisjointEvaluator(String layerName, Evaluator weight) {
+		super();
+		this.layerName = layerName;
+		this.layerNameEvaluator = null;
+		this.weight = weight;
+	}
+
+	BestDisjointEvaluator(Evaluator layerName, Evaluator weight) {
+		super();
+		this.layerName = null;
+		this.layerNameEvaluator = layerName;
+		this.weight = weight;
+	}
+
+	private String getLayerName(EvaluationContext ctx, Element elt) {
+		if (layerNameEvaluator == null)
+			return layerName;
+		return layerNameEvaluator.evaluateString(ctx, elt);
+	}
+
+	@Override
+	public List<Element> evaluateList(EvaluationContext ctx, Element elt) {
+		String name = getLayerName(ctx, elt);
+		Section section = DownCastElement.toSection(elt);
+		if (section == null || !section.hasLayer(name))
+			return Collections.emptyList();
+		Layer layer = section.getLayer(name);
+		Layer selected = layer.selectMaxWeight(new ToDoubleFunction<Annotation>() {
+			@Override
+			public double applyAsDouble(Annotation annotation) {
+				if (weight == null)
+					return DEFAULT_WEIGHT;
+				return weight.evaluateDouble(ctx, annotation);
+			}
+		});
+		return selected.asElementList();
+	}
+
+	@Override
+	public Collection<EvaluationType> getTypes() {
+		return Collections.singleton(EvaluationType.ANNOTATIONS);
+	}
+
+	@Override
+	public void collectUsedNames(NameUsage nameUsage, String defaultType) throws ModuleException {
+		if (layerName != null)
+			nameUsage.addNames(NameType.LAYER, layerName);
+		if (layerNameEvaluator != null)
+			layerNameEvaluator.collectUsedNames(nameUsage, defaultType);
+		if (weight != null)
+			weight.collectUsedNames(nameUsage, defaultType);
+	}
+}
