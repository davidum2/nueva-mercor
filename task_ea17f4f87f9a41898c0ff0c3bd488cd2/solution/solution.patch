+import fr.inra.maiage.bibliome.alvisnlp.core.corpus.expressions.EvaluationContext;
+import fr.inra.maiage.bibliome.alvisnlp.core.corpus.expressions.EvaluationType;
+import fr.inra.maiage.bibliome.alvisnlp.core.corpus.expressions.Evaluator;
+import fr.inra.maiage.bibliome.alvisnlp.core.module.ModuleException;
+import fr.inra.maiage.bibliome.alvisnlp.core.module.NameUsage;
+
+public final class BestDisjointEvaluator extends AbstractListEvaluator {
+    private final String layerName;
+    private final Evaluator layerNameEvaluator;
+    private final Evaluator weightEvaluator;
+
+    public BestDisjointEvaluator(String layerName) {
+        super();
+        this.layerName = layerName;
+        this.layerNameEvaluator = null;
+        this.weightEvaluator = null;
+    }
+
+    public BestDisjointEvaluator(String layerName, Evaluator weightEvaluator) {
+        super();
+        this.layerName = layerName;
+        this.layerNameEvaluator = null;
+        this.weightEvaluator = weightEvaluator;
+    }
+
+    public BestDisjointEvaluator(Evaluator layerNameEvaluator) {
+        super();
+        this.layerName = null;
+        this.layerNameEvaluator = layerNameEvaluator;
+        this.weightEvaluator = null;
+    }
+
+    public BestDisjointEvaluator(Evaluator layerNameEvaluator, Evaluator weightEvaluator) {
+        super();
+        this.layerName = null;
+        this.layerNameEvaluator = layerNameEvaluator;
+        this.weightEvaluator = weightEvaluator;
+    }
+
+    private String getLayerName(EvaluationContext ctx, Element elt) {
+        if (layerNameEvaluator == null)
+            return layerName;
+        return layerNameEvaluator.evaluateString(ctx, elt);
+    }
+
+    @Override
+    public List<Element> evaluateList(EvaluationContext ctx, Element elt) {
+        Section sec = DownCastElement.toSection(elt);
+        if (sec == null) {
+            return Collections.emptyList();
+        }
+        String name = getLayerName(ctx, elt);
+        if (name == null || !sec.hasLayer(name)) {
+            return Collections.emptyList();
+        }
+        Layer layer = sec.getLayer(name);
+        Layer selected = layer.selectMaxWeight(a -> {
+            if (weightEvaluator == null) {
+                return 1.0;
+            }
+            return weightEvaluator.evaluateDouble(ctx, a);
+        });
+        return selected.asElementList();
+    }
+
+    @Override
+    public Collection<EvaluationType> getTypes() {
+        return Collections.singleton(EvaluationType.ANNOTATIONS);
+    }
+
+    @Override
+    public void collectUsedNames(NameUsage nameUsage, String defaultType) throws ModuleException {
+        if (layerName != null) {
+            nameUsage.addNames(NameType.LAYER, layerName);
+        }
+        if (layerNameEvaluator != null) {
+            layerNameEvaluator.collectUsedNames(nameUsage, defaultType);
+        }
+        if (weightEvaluator != null) {
+            weightEvaluator.collectUsedNames(nameUsage, defaultType);
+        }
+    }
+}
