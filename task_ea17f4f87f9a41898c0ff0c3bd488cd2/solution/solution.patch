 import java.util.ListIterator;
+import java.util.function.ToDoubleFunction;
 
 import fr.inra.maiage.bibliome.alvisnlp.core.corpus.creators.AnnotationCreator;
 import fr.inra.maiage.bibliome.util.Strings;
@@ -598,4 +599,121 @@ public class Layer extends AbstractCollection<Annotation> implements Serializabl
     public List<Element> asElementList() {
     	return Collections.unmodifiableList((List<? extends Element>) annotations);
     }
+
+    /**
+     * Selects non-overlapping annotations of this layer so that the sum of their weights is the highest.
+     * If several selections are worth the same, then the one whose indexes in this layer sort first is preferred.
+     * @param weight weight of each annotation, NaN counts as zero
+     * @return a new anonymous layer containing the selected annotations
+     */
+    public Layer selectMaxWeight(ToDoubleFunction<Annotation> weight) {
+        int n = annotations.size();
+        double[] w = new double[n];
+        boolean unbounded = false;
+        for (int i = 0; i < n; ++i) {
+            double x = weight.applyAsDouble(annotations.get(i));
+            w[i] = Double.isNaN(x) ? 0.0 : x;
+            if (w[i] == Double.POSITIVE_INFINITY)
+                unbounded = true;
+        }
+        return subLayer(unbounded ? selectUnbounded(w) : selectBounded(w));
+    }
+
+    private static boolean overlapsAny(Annotation annot, List<Annotation> others) {
+        for (Annotation a : others) {
+            if (a.overlaps(annot))
+                return true;
+        }
+        return false;
+    }
+
+    // Every selection with an infinite weight is worth the same, keep the one that sorts first.
+    private List<Annotation> selectUnbounded(double[] w) {
+        List<Annotation> reachable = new ArrayList<Annotation>();
+        for (int i = 0; i < w.length; ++i) {
+            if (w[i] == Double.POSITIVE_INFINITY)
+                reachable.add(annotations.get(i));
+        }
+        List<Annotation> result = new ArrayList<Annotation>();
+        for (int i = 0; i < w.length; ++i) {
+            Annotation annot = annotations.get(i);
+            if (w[i] == Double.NEGATIVE_INFINITY || overlapsAny(annot, result))
+                continue;
+            if (w[i] == Double.POSITIVE_INFINITY) {
+                result.add(annot);
+                break;
+            }
+            List<Annotation> stillReachable = new ArrayList<Annotation>();
+            for (Annotation a : reachable) {
+                if (!a.overlaps(annot))
+                    stillReachable.add(a);
+            }
+            if (stillReachable.isEmpty())
+                continue;
+            result.add(annot);
+            reachable = stillReachable;
+        }
+        return result;
+    }
+
+    // Annotations that start at the same position are solved together, from the last position to the first.
+    private List<Annotation> selectBounded(double[] w) {
+        int n = w.length;
+        double[] best = new double[n + 1];
+        boolean[] some = new boolean[n + 1];
+        int[] chosen = new int[n];
+        int[] follow = new int[n];
+        boolean[] kept = new boolean[n];
+        for (int hi = n; hi > 0;) {
+            int lo = searchStartLeft(annotations.get(hi - 1).getStart());
+            int points = hi;
+            while (points > lo && annotations.get(points - 1).getLength() == 0)
+                --points;
+            double top = best[hi];
+            for (int i = lo; i < points; ++i) {
+                follow[i] = searchStartLeft(annotations.get(i).getEnd());
+                if (w[i] != Double.NEGATIVE_INFINITY)
+                    top = Math.max(top, w[i] + best[follow[i]]);
+            }
+            int pick = -1;
+            for (int i = lo; i < points && pick < 0; ++i) {
+                if (w[i] + best[follow[i]] == top)
+                    pick = i;
+            }
+            boolean gain = false;
+            for (int i = points; i < hi; ++i) {
+                if (w[i] > 0)
+                    gain = true;
+            }
+            // selecting nothing at all sorts before any other selection worth the same
+            if (pick >= 0 && best[hi] == top && !gain && !some[hi])
+                pick = -1;
+            boolean tail = some[pick < 0 ? hi : follow[pick]];
+            double sum = top;
+            for (int i = hi - 1; i >= points; --i) {
+                if (w[i] > 0 || (w[i] == 0 && tail)) {
+                    kept[i] = true;
+                    tail = true;
+                    sum += w[i];
+                }
+            }
+            best[lo] = sum;
+            some[lo] = tail || pick >= 0;
+            chosen[lo] = pick;
+            hi = lo;
+        }
+        List<Annotation> result = new ArrayList<Annotation>();
+        for (int lo = 0; lo < n;) {
+            int hi = searchStartRight(annotations.get(lo).getStart());
+            int pick = chosen[lo];
+            if (pick >= 0)
+                result.add(annotations.get(pick));
+            for (int i = lo; i < hi; ++i) {
+                if (kept[i])
+                    result.add(annotations.get(i));
+            }
+            lo = pick < 0 ? hi : follow[pick];
+        }
+        return result;
+    }
 }
